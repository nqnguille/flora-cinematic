# OJO: Cloudflare Pages IGNORA el Cache-Control de este archivo para los
# assets estáticos. Se comprobó el 04/08/2026: con estas reglas puestas, la
# cabecera que sirve sigue siendo max-age=3600. O sea que lo de abajo no hace
# lo que dice. Para que un archivo sin hash en el nombre se vea al toque
# después de un deploy hay que VERSIONAR LA URL (ver /admin, que le agrega
# ?v= a cada archivo del panel). Se deja igual por si algún día lo respetan.
/socios/tienda.js
  Cache-Control: no-cache

/socios/tienda.css
  Cache-Control: no-cache


# Cabeceras de seguridad. Este sitio sirve un portal con sesión y un panel
# con DNI de terceros, y no tenía ninguna.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
