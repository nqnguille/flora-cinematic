---
// Login compartido de todo el portal de socios (index, carta, cuenta, admin).
// Una sola experiencia visual: video de cultivo a pantalla completa + dos cards
// (marca a la izq., acceso con Google a la der.). Cada página sigue dueña de
// SU lógica de auth (distinto payload/POST-login), pero todas apuntan a los
// mismos ids (#socios-login, #g_id_button, #socios-login-msg) para que este
// componente sea el único lugar donde vive el diseño del login.
import SolicitudModal from './SolicitudModal.astro'

interface Props {
  eyebrow?: string
  title: string
  tagline?: string
  authTitle?: string
  authSub?: string
  backHref?: string
  hideNote?: boolean
  joinPrompt?: boolean
}
const {
  eyebrow,
  title,
  tagline,
  authTitle,
  authSub,
  backHref = '/',
  hideNote = false,
  joinPrompt = false,
} = Astro.props

// Imán para curiosos que todavía no son socios: la entrada por Google de
// arriba es para quien YA está en el padrón — esto es la puerta de al lado,
// para quien recién está averiguando. Los dos botones abren el MISMO modal
// (mismos 3 campos), con copy distinto según la intención — "Sí, tengo
// REPROCANN" pide acceso a la carta; "Todavía no" coordina la entrevista
// médica, el primer paso para tramitarlo (ver #sl-solicitud-modal).
---

<div id="socios-login" class="sl-login">
  <video class="sl-video" src="/hero/socios-login.mp4" poster="/hero/socios-login_poster.jpg" autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>

  <a href={backHref} class="sl-back">← Volver al sitio</a>

  <div class="sl-split">
    <div class="sl-panel">
      {eyebrow && <span class="sl-eyebrow">{eyebrow}</span>}
      <img class="sl-logo" src="/img/flora-logo-white.png" alt="Flora" width="1472" height="298" />
      <h1 class="sl-title" set:html={title} />
      {tagline && <p class="sl-tagline">{tagline}</p>}

      {authTitle && <div class="sl-divider" aria-hidden="true"></div>}
      {authTitle && <h2 class="sl-auth-title">{authTitle}</h2>}
      {authSub && <p class="sl-sub">{authSub}</p>}
      <div id="g_id_button" class="sl-gbtn"></div>
      <p id="socios-login-msg" class="sl-msg" hidden></p>
      {!hideNote && <div class="sl-note"><slot name="note">Verificamos tu cuenta contra el padrón de socios · no compartimos tus datos.</slot></div>}

      {joinPrompt && (
        <div class="sl-join">
          <div class="sl-join-divider" aria-hidden="true"></div>
          <p class="sl-join-q">¿Todavía no sos socio del club?</p>
          <div class="sl-join-btns">
            <button type="button" id="sl-solicitud-open" data-intent="acceso" class="sl-join-btn">Quiero asociarme · ya tengo REPROCANN</button>
            <a href="https://consultorio.floraong.ar/?agendar=1" class="sl-join-btn sl-join-btn-ghost">Todavía no tengo REPROCANN: agendar entrevista</a>
          </div>

          {/* Tercera vía — SOLO aparece tras el 403 del login (la identidad ya
              vino verificada por Google: se reusa ese mismo credential para
              subir la credencial REPROCANN sin pedir nada dos veces). El
              bloque lo destapa el script de abajo cuando detecta el mensaje
              de "todavía no estás en el padrón". */}
          <div id="sl-aspirante" class="sl-aspirante" hidden>
            <button type="button" id="sl-asp-open" class="sl-join-btn sl-asp-open">
              ¿Ya tenés REPROCANN aprobado como autocultivador?<br />
              <strong>Subí tu credencial y empezá tu pase a Flora.</strong>
            </button>
            <form id="sl-asp-form" class="sl-asp-form" hidden>
              <p class="sl-asp-lead">Tu cuenta de Google ya está verificada: solo falta tu credencial REPROCANN (PDF).</p>
              <label class="sl-asp-field">
                <span>Credencial REPROCANN (PDF)</span>
                <input type="file" id="sl-asp-file" accept="application/pdf" required />
              </label>
              <label class="sl-asp-field">
                <span>Teléfono <em>(opcional)</em></span>
                <input type="tel" id="sl-asp-tel" autocomplete="tel" placeholder="WhatsApp para avisarte" />
              </label>
              <button type="submit" id="sl-asp-submit" class="sl-asp-submit">Subir mi credencial</button>
              <p id="sl-asp-msg" class="sl-asp-msg" hidden></p>
            </form>
            <p id="sl-asp-ok" class="sl-asp-ok" hidden></p>
          </div>
        </div>
      )}
    </div>
  </div>

  {joinPrompt && (
    // Reemplaza los links directos a WhatsApp por un formulario corto
    // (mismo componente que usa la home) que el equipo revisa y aprueba
    // a mano desde /socios/admin (pestaña Solicitudes).
    <SolicitudModal />
  )}
</div>

<script>
  // ── Vía del aspirante autocultivador ─────────────────────────────────
  // Cuando el login con Google rebota con 403 ("todavía no estás en el
  // padrón"), acá se abre la tercera puerta: subir la credencial REPROCANN
  // en el momento, reusando el MISMO credential de Google del login (la
  // identidad ya está verificada; no se le pide el email de nuevo).
  //
  // El credential lo capturamos envolviendo window.handleGoogleCredential:
  // cada página del portal lo asigna y se lo pasa a google.accounts.id como
  // callback, así que un get/set interceptor ve pasar la respuesta de Google
  // sin tocar ninguna página. (El init de Google corre en window.onload,
  // después de todos los módulos: el getter ya devuelve el wrapper.)
  let slAspCredential: string | null = null
  ;(() => {
    let pageHandler: ((r: unknown) => void) | null =
      typeof (window as any).handleGoogleCredential === 'function'
        ? (window as any).handleGoogleCredential
        : null
    const wrapper = (response: any) => {
      slAspCredential = response?.credential || null
      if (pageHandler) return pageHandler(response)
    }
    try {
      Object.defineProperty(window, 'handleGoogleCredential', {
        configurable: true,
        get: () => wrapper,
        set: (fn) => { pageHandler = typeof fn === 'function' ? fn : null },
      })
    } catch { /* sin intercepción no hay vía aspirante; el login sigue igual */ }
  })()

  const aspBlock = document.getElementById('sl-aspirante')
  const loginMsg = document.getElementById('socios-login-msg')
  if (aspBlock && loginMsg) {
    const aspOpen = document.getElementById('sl-asp-open') as HTMLButtonElement
    const aspForm = document.getElementById('sl-asp-form') as HTMLFormElement
    const aspFile = document.getElementById('sl-asp-file') as HTMLInputElement
    const aspTel = document.getElementById('sl-asp-tel') as HTMLInputElement
    const aspSubmit = document.getElementById('sl-asp-submit') as HTMLButtonElement
    const aspMsg = document.getElementById('sl-asp-msg') as HTMLElement
    const aspOk = document.getElementById('sl-asp-ok') as HTMLElement

    // El 403 se reconoce por su firma en el mensaje del login: todas las
    // páginas inyectan ahí el botón .sl-msg-cta de "pedí tu acceso". Un
    // error genuino (token inválido, red) no destapa nada.
    const revelar = () => {
      if (!loginMsg.hidden && loginMsg.querySelector('.sl-msg-cta') && slAspCredential) {
        aspBlock.hidden = false
      }
    }
    new MutationObserver(revelar).observe(loginMsg, {
      childList: true, subtree: true, attributes: true, attributeFilter: ['hidden'],
    })
    revelar()

    aspOpen.addEventListener('click', () => {
      aspOpen.hidden = true
      aspForm.hidden = false
      aspFile.focus()
    })

    // Primer nombre desde el payload del propio ID token (base64url) — solo
    // para el saludo del "¡listo!"; la verificación real la hace el server.
    function nombreDeCredential(cred: string): string {
      try {
        const b64 = cred.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')
        const p = JSON.parse(atob(b64.padEnd(b64.length + ((4 - (b64.length % 4)) % 4), '=')))
        return String(p.given_name || p.name || '').trim().split(/\s+/)[0] || ''
      } catch { return '' }
    }

    const fechaHumana = (iso: string) => {
      const m = String(iso).match(/^(\d{4})-(\d{2})-(\d{2})$/)
      return m ? `${m[3]}/${m[2]}/${m[1]}` : iso
    }

    function errorAsp(texto: string) {
      aspMsg.textContent = texto
      aspMsg.hidden = false
    }

    aspForm.addEventListener('submit', async (e) => {
      e.preventDefault()
      aspMsg.hidden = true
      if (!slAspCredential) {
        errorAsp('Se venció la sesión de Google: entrá con Google de nuevo y volvé a intentar.')
        return
      }
      const file = aspFile.files?.[0]
      if (!file) { errorAsp('Elegí el PDF de tu credencial.'); return }
      const esPdf = file.type === 'application/pdf' || /\.pdf$/i.test(file.name)
      if (!esPdf) { errorAsp('Tiene que ser el PDF de la credencial (no una foto).'); return }
      if (file.size > 8 * 1024 * 1024) { errorAsp('El PDF supera los 8 MB.'); return }

      aspSubmit.disabled = true
      aspSubmit.textContent = 'Subiendo…'
      try {
        const pdfB64 = await new Promise<string>((resolve, reject) => {
          const r = new FileReader()
          r.onload = () => resolve(String(r.result || ''))
          r.onerror = () => reject(r.error)
          r.readAsDataURL(file)
        })
        const res = await fetch('/api/socios/aspirante', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            credential: slAspCredential,
            pdf_base64: pdfB64,
            telefono: aspTel.value.trim(),
          }),
        })
        const data: any = await res.json().catch(() => ({}))
        if (res.ok && data.ok) {
          const nombre = nombreDeCredential(slAspCredential)
          const l = data.leido || {}
          const partes = [
            l.modalidad === 'autocultivo' ? 'Autocultivo' : l.modalidad === 'ong' ? 'Vinculado a ONG' : '',
            l.vence ? `vence ${fechaHumana(l.vence)}` : '',
            l.plantas ? `${l.plantas} plantas` : '',
          ].filter(Boolean).join(' · ')
          aspOk.textContent = partes
            ? `¡Listo${nombre ? ' ' + nombre : ''}! Leímos tu credencial ✓ ${partes}. Te contactamos en breve para terminar tu pase.`
            : `¡Listo${nombre ? ' ' + nombre : ''}! Recibimos tu credencial ✓. Te contactamos en breve para terminar tu pase.`
          aspForm.hidden = true
          aspOk.hidden = false
        } else {
          errorAsp(data.error || 'No se pudo subir, probá de nuevo.')
        }
      } catch {
        errorAsp('Error de red al subir. Probá de nuevo.')
      } finally {
        aspSubmit.disabled = false
        aspSubmit.textContent = 'Subir mi credencial'
      }
    })
  }
</script>

<style is:global>
  /* ═══════════════════════════════════════════════
     SOCIOS LOGIN — componente único para todo el portal
     Video de cultivo de fondo + dos cards de vidrio.
  ═══════════════════════════════════════════════ */
  .sl-login {
    --sl-cream:  #f4f1f7;
    --sl-muted:  rgba(244, 241, 247, 0.55);
    --sl-violet: #b79de6;
    --sl-green:  #3cb492;

    position: relative; overflow: hidden; isolation: isolate;
    min-height: 100svh;
    padding: 0;
    background: #130d1c;
    font-family: var(--font-ui);
  }
  .sl-login[hidden] { display: none; }

  .sl-video {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; object-fit: cover;
    filter: saturate(1.05) brightness(0.9);
  }

  .sl-back {
    position: absolute; z-index: 3; top: var(--space-s); left: var(--space-s);
    color: rgba(244, 241, 247, 0.75); text-decoration: none; font-size: 0.85rem;
    font-family: var(--font-ui);
    text-shadow: 0 1px 12px rgba(0,0,0,0.6);
    transition: color 0.2s ease;
  }
  .sl-back:hover { color: var(--sl-cream); }

  /* Todo el contenido (marca + acceso) apilado en un único panel pegado al
     borde izquierdo; la mitad derecha de la pantalla queda 100% libre para
     el video */
  .sl-split {
    position: relative; z-index: 2;
    min-height: 100svh;
  }

  .sl-panel {
    position: absolute; top: 0; bottom: 0; left: 0;
    width: 58%;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    text-align: center;
    gap: 0.7rem;
    padding: clamp(32px, 5vw, 64px);
    background: rgba(19, 13, 28, 0.9);
    -webkit-backdrop-filter: blur(28px) saturate(1.2); backdrop-filter: blur(28px) saturate(1.2);
    color: var(--sl-cream);
  }

  .sl-divider { width: 42px; height: 1px; background: rgba(183, 157, 230, 0.35); margin: 0.5rem 0; }

  .sl-logo { width: clamp(190px, 24vw, 300px); height: auto; margin-bottom: 0.4rem; }
  /* Misma "tarjeta black" que la card VIP de la home — metal oscuro en vez
     de la pastilla violeta plana, para que el primer texto que se lee ya
     tenga ese aire exclusivo. */
  .sl-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: linear-gradient(155deg, #221c2c 0%, #130f1a 55%, #060409 100%);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 999px; padding: 7px 16px;
    font-size: 0.68rem; font-weight: 700; color: rgba(241,236,244,0.85);
    letter-spacing: 0.16em; text-transform: uppercase;
    box-shadow: 0 10px 22px -10px rgba(0,0,0,0.7), inset 0 1px 0 rgba(255,255,255,0.28), inset 0 -1px 2px rgba(0,0,0,0.6);
    text-shadow: 0 1px 2px rgba(0,0,0,0.5);
  }

  .sl-title {
    font-family: var(--font-display); font-weight: 500; color: var(--sl-cream);
    font-size: clamp(2.1rem, 4.2vw, 3.3rem); line-height: 1.1; margin: 0 auto;
  }
  .sl-title em { font-style: italic; color: var(--sl-violet); }
  .sl-title em.sl-accent-green { color: var(--sl-green); }
  .sl-tagline { line-height: 1.55; color: var(--sl-muted); font-size: 0.92rem; margin: 0 auto; }

  .sl-auth-title { font-family: var(--font-display); font-weight: 500; font-size: clamp(1.3rem, 2vw, 1.6rem); margin: 0; color: var(--sl-cream); }
  .sl-sub { line-height: 1.55; color: var(--sl-muted); font-size: 0.92rem; margin: 0 auto; }
  /* Halo pulsante detrás del botón nativo de Google para que resalte como
     la acción principal — no se puede tocar el estilo del botón en sí
     (vive dentro de un iframe de Google), así que el énfasis se agrega
     alrededor, en el wrapper */
  .sl-gbtn {
    position: relative;
    margin-top: 0.3rem;
    padding: 10px;
    display: flex; justify-content: center;
    width: fit-content; margin-left: auto; margin-right: auto;
    /* botón MUCHO más grande: se escala el wrapper entero (iframe incluido) */
    transform: scale(1.35); transform-origin: center top;
    margin-bottom: 1.4rem;
  }
  @media (max-width: 480px) {
    /* en mobile alcanza con el width:320 del renderButton — sin escala extra
       para que no se desborde en pantallas de 360px */
    .sl-gbtn { transform: none; margin-bottom: 0.4rem; }
  }
  /* box-shadow (no radial-gradient) a propósito: un gradiente circular
     centrado en una caja rectangular ancha (el botón es una píldora, no
     un cuadrado) queda más intenso a los costados que arriba/abajo — se
     nota como un halo parejo. box-shadow con blur+spread sigue el
     border-radius de la caja, así que crece igual de grueso en todo el
     contorno, sea cual sea su forma. */
  .sl-gbtn::before {
    content: '';
    position: absolute; inset: 2px; z-index: -1;
    border-radius: 999px;
    animation: sl-gbtn-glow 2.6s ease-in-out infinite;
  }
  @keyframes sl-gbtn-glow {
    0%, 100% { box-shadow: 0 0 10px 1px rgba(60, 180, 146, 0.4); }
    50% { box-shadow: 0 0 16px 4px rgba(60, 180, 146, 0.65); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sl-gbtn::before { animation: none; box-shadow: 0 0 13px 2px rgba(60, 180, 146, 0.5); }
  }
  .sl-msg { color: var(--sl-violet); font-size: 0.85rem; margin: 0; }
  .sl-note { font-size: 0.78rem; color: rgba(244, 241, 247, 0.4); line-height: 1.5; margin: 0 auto; }
  .sl-note button { background: none; border: none; padding: 0; color: var(--sl-violet); text-decoration: underline; font-size: inherit; font-family: inherit; cursor: pointer; }

  /* Imán para curiosos: puerta de al lado del login, para quien todavía no
     es socio. Deliberadamente más chico y separado — la entrada con Google
     sigue siendo la acción principal de la pantalla. */
  .sl-join { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; margin-top: 1.1rem; opacity: 0.92; }
  .sl-join-divider { width: 42px; height: 1px; background: rgba(183, 157, 230, 0.35); }
  .sl-join-q { font-size: 0.82rem; color: var(--sl-muted); margin: 0; }
  /* Apilados, no uno al lado del otro: son dos caminos distintos y en fila
     el segundo (mucho más largo) desbalanceaba el par. Del mismo ancho, se
     leen como dos opciones comparables. */
  .sl-join-btns { display: flex; flex-direction: column; align-items: stretch; gap: 8px; width: min(340px, 100%); margin-inline: auto; }
  .sl-join-btn {
    display: inline-flex; align-items: center; justify-content: center; text-align: center;
    font-family: var(--font-ui);
    font-size: 0.78rem; font-weight: 700; text-decoration: none;
    padding: 11px 16px; border-radius: 999px; border: 1px solid rgba(60, 180, 146, 0.5);
    background: rgba(60, 180, 146, 0.14); color: var(--sl-green);
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }
  .sl-join-btn:hover { background: rgba(60, 180, 146, 0.24); transform: translateY(-1px); }
  .sl-join-btn-ghost { background: none; border-color: rgba(244, 241, 247, 0.2); color: var(--sl-muted); }
  .sl-join-btn-ghost:hover { border-color: rgba(244, 241, 247, 0.4); background: rgba(244, 241, 247, 0.06); color: var(--sl-cream); }

  /* Tercera vía (aspirante autocultivador): mismo ancho de columna que los
     dos botones de arriba, en violeta para marcar que es OTRO camino — el
     del que ya tiene el REPROCANN aprobado y entra subiendo su credencial.
     Compacto a propósito: en mobile el panel es angosto y con scroll justo. */
  .sl-aspirante { width: min(340px, 100%); margin-inline: auto; display: flex; flex-direction: column; gap: 8px; }
  .sl-aspirante[hidden] { display: none; }
  .sl-asp-open {
    border-color: rgba(183, 157, 230, 0.5); background: rgba(183, 157, 230, 0.12);
    color: var(--sl-violet); line-height: 1.45; font-weight: 500;
  }
  .sl-asp-open:hover { background: rgba(183, 157, 230, 0.2); }
  .sl-asp-open strong { font-weight: 700; }
  .sl-asp-open[hidden] { display: none; }
  .sl-asp-form {
    display: flex; flex-direction: column; gap: 0.7rem; text-align: left;
    background: rgba(183, 157, 230, 0.08); border: 1px solid rgba(183, 157, 230, 0.25);
    border-radius: 16px; padding: 14px;
  }
  .sl-asp-form[hidden] { display: none; }
  .sl-asp-lead { font-size: 0.78rem; color: var(--sl-muted); line-height: 1.5; margin: 0; }
  .sl-asp-field { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.76rem; color: var(--sl-muted); }
  .sl-asp-field em { font-style: normal; opacity: 0.75; }
  .sl-asp-field input[type='file'] {
    font-size: 0.76rem; color: var(--sl-muted); max-width: 100%;
    background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(244, 241, 247, 0.18);
    border-radius: 10px; padding: 0.5em 0.65em;
  }
  .sl-asp-field input[type='tel'] {
    font: inherit; font-size: 0.88rem; color: var(--sl-cream);
    background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(244, 241, 247, 0.18);
    border-radius: 10px; padding: 0.55em 0.75em;
  }
  .sl-asp-field input:focus-visible { outline: 2px solid var(--sl-violet); outline-offset: 1px; border-color: transparent; }
  .sl-asp-submit {
    font-family: var(--font-ui); font-size: 0.82rem; font-weight: 700; cursor: pointer;
    padding: 0.7em 1em; border-radius: 999px; border: none;
    background: var(--sl-violet); color: #1a1026;
    transition: opacity 0.2s ease, transform 0.15s ease;
  }
  .sl-asp-submit:hover:not(:disabled) { transform: translateY(-1px); }
  .sl-asp-submit:disabled { opacity: 0.6; cursor: default; }
  .sl-asp-msg { color: #ff9d9d; font-size: 0.78rem; line-height: 1.45; margin: 0; }
  .sl-asp-msg[hidden] { display: none; }
  .sl-asp-ok {
    font-size: 0.84rem; color: var(--sl-cream); line-height: 1.55; margin: 0;
    background: rgba(60, 180, 146, 0.12); border: 1px solid rgba(60, 180, 146, 0.4);
    border-radius: 16px; padding: 12px 14px; text-align: left;
  }
  .sl-asp-ok[hidden] { display: none; }

  /* Modal "Ya tengo REPROCANN" — estilos en components/SolicitudModal.astro */

  /* Mobile: el panel único ocupa la mitad superior (ancho completo), y el
     video se rota 90° para que el recorte que antes quedaba centro-izquierda
     (donde está la etiqueta en inglés) caiga bajo el panel, no en la mitad
     inferior despejada */
  @media (max-width: 860px) {
    .sl-video {
      inset: auto; top: 50%; left: 50%; right: auto; bottom: auto;
      width: 100vh; height: 100vw;
      transform: translate(-50%, -50%) rotate(90deg);
    }
    .sl-panel {
      left: 0; right: 0; top: 0; bottom: 42%; width: auto; height: auto;
      overflow-y: auto;
      /* "safe center": centra igual que antes cuando el contenido entra
         en pantallas altas, pero en pantallas bajas (iPhone SE y
         similares) donde antes el contenido se desbordaba hacia arriba
         y tapaba el link "Volver al sitio", cae a flex-start en vez de
         seguir centrando fuera de los límites del panel */
      justify-content: safe center;
      gap: 1.15rem;
      padding: clamp(52px, 10vw, 56px) clamp(20px, 6vw, 28px) clamp(18px, 4vw, 26px);
    }
    .sl-logo { width: clamp(190px, 52vw, 260px); }
    .sl-title { font-size: clamp(1.5rem, 6.6vw, 2.1rem); }
    /* Cuando el panel trae el bloque de "todavía no sos socio" (dos botones
       más), el 58% de alto no alcanza: el segundo botón quedaba mordido
       detrás del video, escondido en un scroll interno sin ninguna seña.
       Con ese bloque presente el panel crece y el video queda como cinta
       abajo: todo visible, cero scroll. */
    .sl-panel:has(.sl-join) { bottom: 16%; }

    /* Título, tagline y nota comparten un ancho de columna parecido
       (centrados) para que el bloque se vea simétrico — solo en mobile,
       donde el panel es angosto; en desktop el título necesita su ancho
