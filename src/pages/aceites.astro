---
import CatalogoShell from '../components/CatalogoShell.astro'
import { aceites } from '../lib/productos'
---

<CatalogoShell
  title="Aceites de cannabis medicinal con cromatografía | Flora ONG"
  description="Tres perfiles de aceite —Q1, Q2 y Q3— medidos por cromatografía HPLC. Tu médico indica cuál corresponde a tu tratamiento."
  categoria="aceites"
>
  <section class="fl-section fl-analisis" aria-label="Análisis de laboratorio">
    <div class="fl-wrap">
      <div class="fl-spec">
        <div class="fl-spec-head">
          <span class="fl-eyebrow">Vía de administración: sublingual</span>
          <h1 class="fl-spec-title">Tres perfiles de aceites.<br><em>Múltiples tratamientos.</em></h1>
          <p class="fl-spec-sub">
            Tu médico indica qué perfil corresponde a tu tratamiento. Cada uno tiene su
            propio <strong>análisis de laboratorio</strong>, descargable en su ficha.
          </p>
        </div>

        <div class="fl-spec-grid">
          {aceites.map((a) => (
            <article class="fl-spec-card fl-oil-card" style={`--oil:${a.color}`}>
              <div class="fl-oil-photo" data-id={a.id}>
                <img src={a.img} alt={`Gotero de aceite de cannabis medicinal Flora ${a.codigo}, 10 ml`} loading="lazy" width="600" height="750" />
                <span class="fl-oil-badge">{a.codigo}</span>
              </div>

              <div class="fl-oil-body">
                <h2 class="fl-oil-title">{a.sub}</h2>
                <p class="fl-oil-desc">{a.desc}</p>

                {(() => {
                  const cols = { CBD: 'var(--fl-green)', THC: 'var(--fl-violet)' }
                  const vals = a.perfil
                    .filter((p) => p.k === 'CBD' || p.k === 'THC')
                    .map((p) => ({ k: p.k, v: p.v, n: Number(p.v.replace(',', '.')) }))
                  const total = vals.reduce((s, x) => s + x.n, 0)
                  let acc = 0
                  const stops = vals.map((x) => {
                    const from = (acc / total) * 100
                    acc += x.n
                    const to = (acc / total) * 100
                    return `${cols[x.k]} ${from.toFixed(1)}% ${to.toFixed(1)}%`
                  }).join(', ')
                  return (
                    <div class="fl-oil-chart" aria-label={`Proporción CBD:THC de ${a.codigo}, ${a.ratio}`}>
                      <div class="fl-oil-donut" style={`--ring:conic-gradient(${stops})`}>
                        <div class="fl-oil-donut-hole">
                          <strong>{a.ratio.split('≈')[1].trim()}</strong>
                          <i>{a.ratio.split('≈')[0].trim()}</i>
                        </div>
                      </div>
                      <ul class="fl-oil-legend">
                        {vals.map((x) => (
                          <li>
                            <span class="fl-oil-dot" style={`background:${cols[x.k]}`}></span>
                            <span class="fl-oil-legend-k">{x.k}</span>
                            <strong>{x.v}<i>mg/mL</i></strong>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )
                })()}

                <div class="fl-oil-para">
                  <span class="fl-oil-para-label">Puede acompañar en</span>
                  <ul class="fl-oil-para-list">
                    {a.para.map((c) => <li>{c}</li>)}
                  </ul>
                </div>

                <div class="td-buy td-onlight" data-buy={a.id} hidden>
                  <span class="td-buy-label">Reservar</span>
                  <div class="td-buy-row">
                    <span class="td-precio" data-id={a.id}></span>
                    <div class="td-slot" data-id={a.id}></div>
                  </div>
                </div>

                <div class="fl-oil-actions">
                  <a class="fl-oil-btn" href={a.href} target="_blank" rel="noopener noreferrer">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.867 11.867 0 0 1-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 0 1 8.413 3.488 11.824 11.824 0 0 1 3.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 0 1-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 0 0 1.51 5.26l-.999 3.648 3.477-.911zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/></svg>
                    Consultar por este aceite
                  </a>
                  <a class="fl-oil-download" href={a.pdf} download>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><g class="fx-traz"><path d="M6.2 2.8h7.6l4.4 4.4v13a1.6 1.6 0 0 1-1.6 1.6H6.2a1.6 1.6 0 0 1-1.6-1.6V4.4a1.6 1.6 0 0 1 1.6-1.6Z"/></g><g class="fx-lleno"><path d="M13.6 2.8v4.6h4.6z"/><rect x="7.4" y="9.2" width="5" height="1.9" rx=".95"/><path d="M10.9 12.6h2.2v3.2h2.1L12 19.4l-3.2-3.6h2.1z"/></g></svg>
                    Descargar análisis de cromatografía
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</CatalogoShell>
