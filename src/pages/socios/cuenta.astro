    .cu-gw { margin-top: 4px; }

    /* chips compartidos (plan y REPROCANN) */
    .cu-chip { display: inline-flex; align-items: center; font-size: 0.74rem; font-weight: 700;
      padding: 5px 12px; border-radius: 999px; background: rgba(183, 157, 230, 0.12);
      color: #b79de6; border: 1px solid rgba(183, 157, 230, 0.3); white-space: nowrap; }
