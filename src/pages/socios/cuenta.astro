---
import Layout from '../../layouts/Layout.astro'
import SociosLogin from '../../components/SociosLogin.astro'
import SociosTos from '../../components/SociosTos.astro'
import SociosGateway from '../../components/SociosGateway.astro'
import '../../styles/global.css'

const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || ''
---

<Layout
  title="Mi cuenta — socios | Flora ONG"
  description="Tu perfil de socio: reserva en curso e historial de reservas."
  noindex={true}
>
  <link rel="stylesheet" href="/socios/tienda.css" />
  <main class="td-main">
    <!-- El mismo sello que el loader de la primera visita de la home: papel
         blanco, el anillo tenue de referencia, el anillo que se llena en
         barrido angular y la chala fija en el centro. -->
    <div id="cu-portero" class="cu-portero" hidden aria-hidden="true">
      <div class="cu-portero-anillo">
        <img class="cu-portero-track" src="/img/loader-ring.png" alt="" />
        <img class="cu-portero-fill" src="/img/loader-ring.png" alt="" />
        <img class="cu-portero-leaf" src="/img/loader-leaf.png" alt="" />
      </div>
    </div>
    <script is:inline>
      // Síncrono a propósito: corre antes del primer paint de lo que sigue.
      try {
        if (localStorage.getItem('flora-socio-hint')) {
          var portero0 = document.getElementById('cu-portero')
          portero0.hidden = false
          // La O se dibuja UNA sola vez, completa, con easing (suave al
          // final), en ~950ms. El contrato con el resto de la página vive en
          // dos banderitas del DOM: 'completo' la pone esta animación al
          // terminar; 'soltar' la pone quien quiera levantar el velo. El velo
          // se levanta recién cuando las dos están: así la vuelta nunca corta
          // la O a medio dibujar, y la O nunca arranca de nuevo.
          var fill0 = portero0.querySelector('.cu-portero-fill')
          var ini0 = null, dur0 = 950
          function paso0(t) {
            if (ini0 === null) ini0 = t
            var k = Math.min(1, (t - ini0) / dur0)
            var e = 1 - Math.pow(1 - k, 3)  // easeOutCubic: fluido, sin golpe
            fill0.style.setProperty('--pct', (e * 100).toFixed(2))
            if (k < 1) { requestAnimationFrame(paso0); return }
            portero0.dataset.completo = '1'
            if (portero0.dataset.soltar === '1') portero0.hidden = true
          }
          requestAnimationFrame(paso0)
        }
      } catch (e) {}
    </script>

    <!-- ── Login ── -->
    <SociosLogin title="Acceso exclusivo para<br /><em class='sl-accent-green'>miembros del club</em>" joinPrompt>
      <Fragment slot="note">Validamos tu identidad en nuestra base de pacientes.<br />No compartimos tus datos.</Fragment>
    </SociosLogin>
    <SociosTos />

    <!-- ── Cuenta ── -->
    <div id="cu-content" class="td-content" hidden>
      <div class="td-head">
        <div class="td-brand"><img class="td-brand-logo" src="/img/flora-logo-white.png" alt="Flora" width="1472" height="298" /><span class="td-brand-name"><em>club</em></span></div>
        <div class="td-acciones">
          <a href="/" class="td-back">← Volver al sitio</a>
          <a href="/socios/carta/" class="td-back">Carta</a>
          <a href="/socios/membresias/" class="td-back">Membresías</a>
          <button id="cu-logout" class="td-logout" type="button">Cerrar sesión</button>
        </div>
      </div>

      <div class="cu-perfil">
        <img id="cu-foto" class="cu-foto" alt="" width="64" height="64" hidden />
        <div class="cu-perfil-datos">
          <h1 class="td-title">Hola, <em id="cu-nombre">socio</em></h1>
          <p id="cu-email" class="cu-email"></p>
        </div>
      </div>

      <!-- Saldo de gramos: lo único de finanzas que ve el socio (sin plata) -->
      <section class="cu-sec" id="cu-saldo-sec" hidden>
        <h2 class="cu-sec-title">Tu plan</h2>
        <div class="cu-saldo-card">
          <div class="cu-saldo-head">
            <div class="cu-saldo-num"><b id="cu-saldo-g">—</b><span id="cu-saldo-det"></span></div>
            <span class="cu-chip" id="cu-plan-chip" hidden></span>
          </div>
          <div class="cu-saldo-bar"><i id="cu-saldo-fill"></i></div>
          <p class="cu-saldo-sub" id="cu-saldo-sub"></p>
          <p class="cu-saldo-sub" id="cu-aldia" hidden></p>
          <!-- Link a la página de membresías (mismo estilo que "Ver el trámite completo") -->
          <a class="cu-rp-ir" href="/socios/membresias/">Ver membresías →</a>
        </div>
      </section>

      <!-- REPROCANN: estado, vencimiento y la guantera del certificado -->
      <section class="cu-sec" id="cu-rp-sec">
        <h2 class="cu-sec-title">Tu REPROCANN</h2>
        <div class="cu-saldo-card">
          <div class="cu-rp-fila">
            <span class="cu-chip" id="cu-rp-chip">…</span>
            <span class="cu-rp-vence" id="cu-rp-vence"></span>
          </div>
          <a class="cu-cert" id="cu-cert" href="/api/socios/certificado" hidden><svg class="fx-ico" viewBox="0 0 24 24" aria-hidden="true"><g class="fx-traz"><path d="M6.2 2.8h7.6l4.4 4.4v13a1.6 1.6 0 0 1-1.6 1.6H6.2a1.6 1.6 0 0 1-1.6-1.6V4.4a1.6 1.6 0 0 1 1.6-1.6Z"/></g><g class="fx-lleno"><path d="M13.6 2.8v4.6h4.6z"/><rect x="7.4" y="11.6" width="9.2" height="1.9" rx=".95"/><rect x="7.4" y="15.2" width="6.2" height="1.9" rx=".95"/></g></svg> Descargar mi certificado (PDF)<small>Tu certificado oficial, siempre a mano.</small></a>
          <a class="cu-cert cu-rp-turno" id="cu-rp-turno" href="https://consultorio.floraong.ar/?agendar=1" hidden></a>
          <a class="cu-rp-ir" href="/socios/reprocann/">Ver el trámite completo →</a>
        </div>
      </section>

      <!-- DECLARACIÓN JURADA: la renuncia al autocultivo que el socio firma
           acá mismo, en el portal. Solo aparece si /api/socios/ddjj dice que
           le aplica (autocultivadores en conversión); para el resto del
           padrón la sección no existe. -->
      <section class="cu-sec" id="cu-dj-sec" hidden>
        <h2 class="cu-sec-title">Declaración jurada</h2>
        <div class="cu-saldo-card" id="cu-dj-card"></div>
      </section>

      <section class="cu-sec">
        <h2 class="cu-sec-title">Reserva en curso</h2>
        <div id="cu-activo" class="cu-lista"></div>
        <p id="cu-sin-activo" class="cu-vacio" hidden>Sin reservas en curso. <a href="/socios/carta/">Mirá la carta →</a></p>
      </section>

      <section class="cu-sec" id="cu-retiros-sec" hidden>
        <h2 class="cu-sec-title">Tus retiros</h2>
        <div class="cu-saldo-card">
          <!-- Cabecera estática de la tabla: las filas las escribe el JS abajo. -->
          <div class="cu-retiros-cab" aria-hidden="true"><span>Fecha</span><span>Producto</span><b>Cantidad</b></div>
          <div class="cu-saldo-retiros" id="cu-saldo-retiros"></div>
          <button class="cu-vermas" id="cu-vermas" type="button" hidden>Ver historial completo</button>
        </div>
      </section>

      <section class="cu-sec">
        <h2 class="cu-sec-title">Historial de reservas</h2>
        <div id="cu-historial" class="cu-lista"></div>
        <p id="cu-sin-historial" class="cu-vacio" hidden>Todavía no hiciste reservas.</p>
      </section>

      <section class="cu-sec">
        <h2 class="cu-sec-title">Categorías</h2>
        <SociosGateway class="cu-gw" />
      </section>
    </div>

    <!-- Modal de la declaración jurada: el documento completo scrolleable,
         los dos campos de la firma y el checkbox. Mismo lenguaje de overlay
         que el modal de términos (SociosTos). -->
    <div id="cu-dj-modal" class="cu-dj-modal" hidden data-lenis-prevent>
      <div class="cu-dj-modal-card" role="dialog" aria-modal="true" aria-labelledby="cu-dj-title">
        <h2 id="cu-dj-title" class="cu-dj-title">Declaración <em>jurada</em></h2>
        <p class="cu-dj-meta" id="cu-dj-meta"></p>
        <!-- El marco (fondo, borde, radius) y el scroll van en DOS divs a
             propósito: una capa de scroll compuesta CON fondo y radius adentro
             de un modal con backdrop-filter se renderiza invertida en Chrome
             (misma familia de bugs de compositor que el grano de la casa). El
             scroll pelado adentro, como el cuerpo del modal de términos, no
             dispara el bug. -->
        <div class="cu-dj-doc">
          <div id="cu-dj-doc" class="cu-dj-doc-scroll"></div>
        </div>
        <label class="cu-dj-lab" for="cu-dj-nombre">Tu nombre completo, como figura en tu DNI</label>
        <input id="cu-dj-nombre" class="cu-dj-input" type="text" autocomplete="name" placeholder="Nombre y apellido" />
        <label class="cu-dj-lab" for="cu-dj-dni">Tu DNI (solo números)</label>
        <input id="cu-dj-dni" class="cu-dj-input" type="text" inputmode="numeric" autocomplete="off" placeholder="Sin puntos" />
        <label class="cu-dj-lab">Tu firma, dibujada con el dedo (o el mouse)</label>
        <div class="cu-dj-pad">
          <canvas id="cu-dj-firma"></canvas>
          <span class="cu-dj-pad-guia" id="cu-dj-pad-guia">Firmá acá adentro</span>
          <button type="button" id="cu-dj-borrar" class="cu-dj-pad-borrar" hidden>Borrar</button>
        </div>
        <label class="cu-dj-check">
          <input type="checkbox" id="cu-dj-acepto" />
          <span>Leí y acepto: esta firma electrónica expresa mi voluntad.</span>
        </label>
        <p id="cu-dj-msg" class="cu-dj-msg" hidden></p>
        <div class="cu-dj-actions">
          <button id="cu-dj-cerrar" class="cu-dj-btn-ghost" type="button">Cerrar</button>
          <button id="cu-dj-firmar" class="cu-dj-btn-primary" type="button" disabled>Firmar declaración</button>
        </div>
      </div>
    </div>
  </main>

  <script src="https://accounts.google.com/gsi/client" async defer is:inline></script>
  <script define:vars={{ googleClientId }}>
    const esc = (x) => String(x ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]))
    const FECHA = (iso) => {
      try {
        return new Date(iso).toLocaleDateString('es-AR', { day: 'numeric', month: 'short', year: 'numeric' })
      } catch { return '' }
    }
    const ESTADO = {
      pendiente: ['En preparación', 'is-pendiente'],
      listo: ['Lista para retirar', 'is-listo'],
      entregado: ['Entregada', 'is-entregado'],
      cancelado: ['Cancelada', 'is-cancelado'],
    }
    const badge = (estado) => {
      const [txt, cls] = ESTADO[estado] || [estado, '']
      return `<span class="td-cart-badge ${cls}">${esc(txt)}</span>`
    }
    const lineas = (p) => p.items
      .map((i) => `${i.cantidad}${i.formato === 'flor' ? ' g' : ' ×'} ${esc(i.nombre)}${i.formato === 'preroll' ? ' (preroll)' : ''}`)
      .join(' · ')

    function pedidoCard(p, esActivo) {
      return `
        <article class="cu-pedido${esActivo ? ' is-activo' : ''}">
          <div class="cu-pedido-head">
            <span class="cu-pedido-fecha">${FECHA(p.creado)}</span>
            ${badge(p.estado)}
          </div>
          <p class="cu-pedido-items">${lineas(p)}</p>
          ${p.nota ? `<p class="cu-pedido-nota"><svg class="fx-ico" viewBox="0 0 24 24" aria-hidden="true"><g class="fx-traz"><rect x="4.2" y="3" width="13.6" height="18" rx="2.2"/></g><g class="fx-lleno"><rect x="7" y="7.6" width="7" height="1.7" rx=".85"/><rect x="7" y="11" width="5.4" height="1.7" rx=".85"/><path d="M13.7 15.2l2.1 2.1 5.6-5.6-2.1-2.1z"/><path d="M12.6 18.4l1.1-3.2 2.1 2.1z"/></g></svg> ${esc(p.nota)}</p>` : ''}
        </article>`
    }

    /* ── Reserva en curso EDITABLE (solo mientras está pendiente) ── */
    let edicion = null // { id, items: [{id, formato, cantidad, nombre, precio}] }

    function totalEstimado(items) {
      return items.reduce((s, i) => s + (Number(i.precio) > 0 ? Number(i.precio) * i.cantidad : 0), 0)
    }

    function reservaEditor(p) {
      const conPrecio = totalEstimado(p.items)
      const hayFlores = p.items.some((i) => i.formato === 'flor')
      return `
        <article class="cu-pedido is-activo">
          <div class="cu-pedido-head">
            <span class="cu-pedido-fecha">${FECHA(p.creado)}</span>
            ${badge(p.estado)}
          </div>
          ${p.items.map((i, ix) => `
            <div class="cu-ed-item">
              <div class="cu-ed-nombre">${esc(i.nombre)}${i.formato === 'preroll' ? ' <small>(preroll)</small>' : ''}
                ${i.formato === 'flor' ? '<small>va contra tus gramos</small>' : ''}</div>
              <div class="cu-ed-step">
                <button type="button" data-ix="${ix}" data-d="-1" aria-label="Menos">−</button>
                <b>${i.cantidad}${i.formato === 'flor' ? ' g' : ''}</b>
                <button type="button" data-ix="${ix}" data-d="1" aria-label="Más">+</button>
              </div>
            </div>`).join('')}
          ${conPrecio ? `<div class="cu-ed-total"><span>Total estimado${hayFlores ? ' (productos)' : ''}</span><b>$ ${conPrecio.toLocaleString('es-AR')}</b></div>` : ''}
          ${p.nota ? `<p class="cu-pedido-nota"><svg class="fx-ico" viewBox="0 0 24 24" aria-hidden="true"><g class="fx-traz"><rect x="4.2" y="3" width="13.6" height="18" rx="2.2"/></g><g class="fx-lleno"><rect x="7" y="7.6" width="7" height="1.7" rx=".85"/><rect x="7" y="11" width="5.4" height="1.7" rx=".85"/><path d="M13.7 15.2l2.1 2.1 5.6-5.6-2.1-2.1z"/><path d="M12.6 18.4l1.1-3.2 2.1 2.1z"/></g></svg> ${esc(p.nota)}</p>` : ''}
          <div class="cu-ed-acciones">
            <button class="cu-ed-btn is-borrar" id="cu-ed-cancelar" type="button">Cancelar reserva</button>
            <button class="cu-ed-btn is-guardar" id="cu-ed-guardar" type="button" disabled>Guardar cambios</button>
          </div>
          <p class="cu-saldo-sub" id="cu-ed-msg" hidden></p>
        </article>`
    }

    function pintarActivo(activo) {
      const caja = document.getElementById('cu-activo')
      if (!activo) { caja.innerHTML = ''; document.getElementById('cu-sin-activo').hidden = false; return }
      document.getElementById('cu-sin-activo').hidden = true
      if (activo.estado !== 'pendiente') { caja.innerHTML = pedidoCard(activo, true); return }

      edicion = { id: activo.id, creado: activo.creado, nota: activo.nota, estado: activo.estado, items: activo.items.map((i) => ({ ...i })) }
      caja.innerHTML = reservaEditor(edicion)

      const PASO = (i) => (i.formato === 'flor' ? 1 : 1)
      caja.querySelectorAll('.cu-ed-step button').forEach((b) => b.addEventListener('click', () => {
        const it = edicion.items[Number(b.dataset.ix)]
        it.cantidad = Math.max(0, it.cantidad + Number(b.dataset.d) * PASO(it))
        edicion.items = edicion.items.filter((i) => i.cantidad > 0)
        caja.innerHTML = edicion.items.length ? reservaEditor(edicion) : ''
        if (!edicion.items.length) {
          // sin ítems = cancelar: mejor preguntar antes que mandar
          if (confirm('¿Cancelar la reserva completa?')) { guardarReserva([]) } else { cargar() }
          return
        }
        pintarActivo({ ...edicion })
        document.getElementById('cu-ed-guardar').disabled = false
      }))
      caja.querySelector('#cu-ed-guardar')?.addEventListener('click', () => guardarReserva(edicion.items))
      caja.querySelector('#cu-ed-cancelar')?.addEventListener('click', () => {
        if (confirm('¿Cancelar la reserva completa?')) guardarReserva([])
      })
    }

    async function guardarReserva(items) {
      const msg = document.getElementById('cu-ed-msg')
      if (msg) { msg.hidden = false; msg.textContent = 'Guardando…' }
      const r = await fetch('/api/socios/pedidos', {
        method: 'PUT', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: edicion.id, items: items.map((i) => ({ id: i.id, formato: i.formato, cantidad: i.cantidad })) }),
      })
      const d = await r.json().catch(() => ({}))
      if (!r.ok) {
        if (msg) { msg.textContent = d.error || 'No se pudo guardar. Probá de nuevo.' }
        return
      }
      cargar()
    }

    const portero = document.getElementById('cu-portero')
    // Levantar el velo respetando el contrato: si la O ya se completó, va; si
    // todavía se está dibujando, deja la banderita y la levanta la animación.
    const soltarPortero = () => {
      if (!portero) return
      if (portero.dataset.completo === '1') portero.hidden = true
      else portero.dataset.soltar = '1'
    }
    // Red de seguridad: si la red se cuelga, el velo no puede ser una trampa
    // (acá sí a mano, sin esperar a nadie).
    setTimeout(() => { if (portero) portero.hidden = true }, 6000)

    async function cargar() {
      const [yoRes, pedRes] = await Promise.all([
        fetch('/api/socios/yo', { credentials: 'include' }),
        fetch('/api/socios/pedidos', { credentials: 'include' }),
      ])
      // Sin sesión válida no se pinta nada: queda la pantalla de acceso. La
      // marquita se borra para que la próxima recarga muestre el login directo.
      if (!yoRes.ok || !pedRes.ok) {
        try { localStorage.removeItem('flora-socio-hint') } catch (e) {}
        soltarPortero()
        return false
      }
      try { localStorage.setItem('flora-socio-hint', '1') } catch (e) {}
      const yo = await yoRes.json()
      const ped = await pedRes.json()

      document.getElementById('cu-nombre').textContent = (yo.name || 'socio').split(/\s+/)[0]
      document.getElementById('cu-email').textContent = yo.email || ''
      if (yo.picture) {
        const f = document.getElementById('cu-foto')
        f.src = yo.picture
        f.hidden = false
      }

      const activo = ped.activo
      pintarActivo(activo)

      const resto = (ped.pedidos || []).filter((p) => !activo || p.id !== activo.id)
      document.getElementById('cu-historial').innerHTML = resto.map((p) => pedidoCard(p, false)).join('')
      document.getElementById('cu-sin-historial').hidden = resto.length > 0

      document.getElementById('socios-login').hidden = true
      document.getElementById('cu-content').hidden = false
      soltarPortero()
      cargarSaldo()
      cargarReprocann()
      cargarDdjj()
      return true
    }

    // Estado del REPROCANN + certificado en la propia cuenta
    async function cargarReprocann() {
      try {
        const res = await fetch('/api/socios/codigo', { credentials: 'include' })
        if (!res.ok) return
        const d = await res.json()
        rpInfo = d // la puerta del certificado cruza este estado con el de la DDJJ
        evaluarCertCta()
        const chip = document.getElementById('cu-rp-chip')
        const vence = document.getElementById('cu-rp-vence')
        if (!d.vinculado) { chip.textContent = 'Sin vincular'; chip.className = 'cu-chip'; return }
        const TXT = {
          aprobado: ['✓ Aprobado', 'is-ok'], autocultivo: ['Autocultivador', 'is-ok'],
          ddjj_pendiente: ['Te toca firmar la declaración', 'is-vos'], ddjj_firmada: ['Declaración en verificación', ''],
          conversion: ['Pasando tu REPROCANN a Flora', 'is-ok'],
          en_evaluacion: ['En evaluación', ''], revision_medica: ['En corrección', ''],
          a_vincular: ['Vinculándote', ''], cargado: ['Te toca firmar', 'is-vos'],
          observado: ['Observado', 'is-vos'], codigo_listo: ['Con el médico', ''],
          sin_iniciar: ['Falta tu código', 'is-vos'], esperando_codigo: ['Falta tu código', 'is-vos'],
          revisar: ['Falta tu código', 'is-vos'], vencido: ['Vencido', 'is-mal'], rechazado: ['Rechazado', 'is-mal'],
        }
        const [txt, cls] = TXT[d.estado] || [d.estado || '—', '']
        chip.textContent = txt
        chip.className = 'cu-chip ' + cls
        if (d.vence && ['aprobado', 'autocultivo', 'conversion', 'vencido'].includes(d.estado)) {
          const dias = Math.floor((Date.parse(d.vence) - Date.now()) / 86400000)
          const f = d.vence.slice(0, 10).split('-').reverse().join('/')
          vence.textContent = dias < 0 ? `venció el ${f}` : `vence el ${f} · faltan ${dias} días`
          vence.style.color = dias < 0 ? '#ff9d9d' : dias <= 60 ? '#e6a83e' : ''
        }
        document.getElementById('cu-cert').hidden = !d.certificado
        // Turno de consulta según dónde está parado: renovar si vence o venció,
        // arrancar el trámite si todavía le falta la entrevista.
        const turno = document.getElementById('cu-rp-turno')
        if (turno) {
          const dias = d.vence ? Math.floor((Date.parse(d.vence) - Date.now()) / 86400000) : null
          const faltaEntrevista = ['sin_iniciar', 'esperando_codigo', 'revisar', 'codigo_listo'].includes(d.estado)
          if (d.estado === 'vencido' || (dias != null && dias <= 60)) {
            turno.innerHTML = '<svg class="fx-ico" viewBox="0 0 24 24" aria-hidden="true"><g class="fx-traz"><rect x="3.4" y="4.8" width="17.2" height="16" rx="2.4"/><path d="M8 2.4v4M16 2.4v4"/></g><g class="fx-lleno"><rect x="4.4" y="5.8" width="15.2" height="3.6"/><circle cx="8.4" cy="14" r="1.4"/><rect x="11.6" y="12.9" width="5.4" height="2.2" rx="1.1"/><rect x="7" y="16.6" width="10" height="2.2" rx="1.1"/></g></svg> Agendar la consulta de renovación<small>Tu certificado ' + (dias != null && dias < 0 ? 'venció' : 'está por vencer') + ': se renueva con una consulta.</small>'
            turno.hidden = false
          } else if (faltaEntrevista) {
            turno.innerHTML = '<svg class="fx-ico" viewBox="0 0 24 24" aria-hidden="true"><g class="fx-traz"><rect x="3.4" y="4.8" width="17.2" height="16" rx="2.4"/><path d="M8 2.4v4M16 2.4v4"/></g><g class="fx-lleno"><rect x="4.4" y="5.8" width="15.2" height="3.6"/><circle cx="8.4" cy="14" r="1.4"/><rect x="11.6" y="12.9" width="5.4" height="2.2" rx="1.1"/><rect x="7" y="16.6" width="10" height="2.2" rx="1.1"/></g></svg> Agendar tu entrevista médica<small>Es el paso que falta para que salga tu REPROCANN.</small>'
            turno.hidden = false
          }
        }
      } catch { /* la tarjeta queda con el chip vacío, nada más */ }
    }

    /* ── Declaración jurada: la renuncia al autocultivo se firma acá ── */
    // Si la API falla o dice que no aplica, la sección simplemente no existe:
    // este fetch jamás bloquea ni rompe el resto de la cuenta.
    async function cargarDdjj() {
      try {
        const res = await fetch('/api/socios/ddjj', { credentials: 'include' })
        if (!res.ok) return
        pintarDdjj(await res.json())
      } catch { /* la sección queda oculta, nada más */ }
    }

    function pintarDdjj(d) {
      const sec = document.getElementById('cu-dj-sec')
      const card = document.getElementById('cu-dj-card')
      if (!d || !d.aplica) {
        // Sin declaración no siempre es "nada que hacer": si el socio figura
        // como autocultivador, esta misma tarjeta se vuelve la puerta para
        // subir su certificado (evaluarCertCta decide con las dos respuestas).
        djAplica = false
        sec.hidden = true
        evaluarCertCta()
        return
      }
      djAplica = true
      if (d.estado === 'generada') {
        card.innerHTML = `
          <div class="cu-rp-fila"><span class="cu-chip is-vos">Te toca firmar</span></div>
          <p class="cu-dj-intro">Para que Flora cultive por vos, REPROCANN exige que renuncies al autocultivo. Esa renuncia es esta declaración jurada, ya redactada a tu nombre: leela completa y firmala acá, con tu nombre y tu DNI.</p>
          <button class="cu-cert cu-dj-abrir" id="cu-dj-abrir" type="button"><svg class="fx-ico" viewBox="0 0 24 24" aria-hidden="true"><g class="fx-traz"><rect x="4.2" y="3" width="13.6" height="18" rx="2.2"/></g><g class="fx-lleno"><rect x="7" y="7.6" width="7" height="1.7" rx=".85"/><rect x="7" y="11" width="5.4" height="1.7" rx=".85"/><path d="M13.7 15.2l2.1 2.1 5.6-5.6-2.1-2.1z"/><path d="M12.6 18.4l1.1-3.2 2.1 2.1z"/></g></svg> Leer y firmar<small>Tu firma electrónica queda sellada con fecha, hora y evidencia.</small></button>`
        document.getElementById('cu-dj-abrir').addEventListener('click', () => abrirDdjj(d))
      } else if (d.estado === 'firmada') {
        card.innerHTML = `
          <div class="cu-rp-fila"><span class="cu-chip">Firmada · en verificación</span></div>
          <p class="cu-dj-intro">Ya firmaste tu renuncia al autocultivo. El equipo la va a verificar y tu trámite sigue solo.</p>`
      } else if (d.estado === 'verificada') {
        card.innerHTML = `
          <div class="cu-rp-fila"><span class="cu-chip is-ok">✓ Verificada</span></div>
          <p class="cu-dj-intro">Tu declaración quedó verificada: estamos pasando tu REPROCANN a Flora y no tenés que hacer nada más. Ya podés adherirte a tu membresía desde <a href="/socios/membresias/">Membresías</a>.</p>`
      } else { sec.hidden = true; return }
      sec.hidden = false
    }

    /* ── La puerta de autoservicio del autocultivador ──
       Si la DDJJ dice "no aplica" pero el REPROCANN dice "autocultivador",
       lo que falta es el certificado: el socio lo sube acá, el server lo lee
       y le deja la renuncia lista para firmar en la misma sentada. Las dos
       respuestas llegan en paralelo, así que cada carga anota lo suyo y la
       que llega última pinta. */
    let djAplica = null // null = /api/socios/ddjj todavía no respondió
    let rpInfo = null   // la respuesta de /api/socios/codigo

    function evaluarCertCta() {
      if (djAplica !== false || !rpInfo || rpInfo.estado !== 'autocultivo') return
      const sec = document.getElementById('cu-dj-sec')
      const card = document.getElementById('cu-dj-card')
      if (rpInfo.certificado) {
        // ya subió (o el club ya lo cargó) y la declaración todavía no está:
        // la está armando el equipo, no hay nada más que apretar
        card.innerHTML = `
          <div class="cu-rp-fila"><span class="cu-chip">Certificado recibido</span></div>
          <p class="cu-dj-intro">Recibimos tu certificado: te avisamos en cuanto tu declaración esté lista.</p>`
        sec.hidden = false
        return
      }
      card.innerHTML = `
        <div class="cu-rp-fila"><span class="cu-chip is-vos">Pasate a Flora</span></div>
        <p class="cu-dj-intro">¿Querés que Flora cultive por vos? Subí tu certificado REPROCANN y te dejamos la renuncia lista para firmar acá mismo.</p>
        <input type="file" id="cu-dj-cert-file" accept="application/pdf,.pdf" hidden />
        <button class="cu-cert cu-dj-abrir" id="cu-dj-cert-btn" type="button"><svg class="fx-ico" viewBox="0 0 24 24" aria-hidden="true"><g class="fx-traz"><path d="M4.4 15.6v3.2a2 2 0 0 0 2 2h11.2a2 2 0 0 0 2-2v-3.2"/></g><g class="fx-lleno"><path d="M12 2.8l4.8 5.2h-3.1v7h-3.4V8H7.2z"/></g></svg> Subir mi certificado (PDF)<small>Lo leemos al toque y armamos tu declaración.</small></button>
        <p id="cu-dj-cert-msg" class="cu-dj-msg" hidden></p>`
      const file = document.getElementById('cu-dj-cert-file')
      document.getElementById('cu-dj-cert-btn').addEventListener('click', () => file.click())
      file.addEventListener('change', () => {
        if (file.files && file.files[0]) subirCert(file.files[0])
        file.value = '' // que se pueda reelegir el mismo archivo tras un error
      })
      sec.hidden = false
    }

    async function subirCert(f) {
      const btn = document.getElementById('cu-dj-cert-btn')
      const msg = document.getElementById('cu-dj-cert-msg')
      const aviso = (t, mal) => {
        msg.textContent = t
        msg.classList.toggle('is-error', !!mal)
        msg.hidden = false
      }
      if (!/pdf$/i.test(f.type || '') && !/\.pdf$/i.test(f.name || '')) return aviso('Subí el PDF oficial de tu certificado.', true)
      if (f.size > 8 * 1024 * 1024) return aviso('El PDF es muy pesado (máx. 8 MB).', true)
      btn.disabled = true
      aviso('Subiendo y leyendo tu certificado…', false)
      try {
        const b64 = await new Promise((res, rej) => {
          const r = new FileReader()
          r.onload = () => res(r.result)
          r.onerror = () => rej(new Error('lectura'))
          r.readAsDataURL(f)
        })
        const r = await fetch('/api/socios/certificado', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pdf_base64: b64 }),
        })
        const d = await r.json().catch(() => ({}))
        if (!r.ok) {
          btn.disabled = false
          return aviso(d.error || 'No se pudo subir. Probá de nuevo.', true)
        }
        if (d.ddjj_generada) {
          // la declaración ya existe: recargar las dos tarjetas hace aparecer
          // el "Te toca firmar" al toque, en esta misma tarjeta
          cargarDdjj()
          cargarReprocann()
        } else {
          // el certificado quedó, pero la DDJJ la va a armar el equipo (falta
          // el diagnóstico, o el DNI no coincidió): el botón se apaga y queda
          // el mensaje. No se repinta para no pisar la advertencia.
          rpInfo.certificado = true
          aviso(d.advertencia || 'Recibimos tu certificado: te avisamos en cuanto tu declaración esté lista.', false)
        }
      } catch {
        btn.disabled = false
        aviso('Error de red. Probá de nuevo.', true)
      }
    }

    function abrirDdjj(d) {
      document.getElementById('cu-dj-meta').textContent = `${d.documento.entidad} · plantilla ${d.documento.version}`
      document.getElementById('cu-dj-doc').innerHTML =
        `<h3>${esc(d.documento.titulo)}</h3><p class="cu-dj-sub">${esc(d.documento.subtitulo)}</p>` +
        d.documento.parrafos.map((t) => `<p>${esc(t)}</p>`).join('') +
        `<p class="cu-dj-cierre">${esc(d.documento.cierre)}</p>`
      document.getElementById('cu-dj-nombre').value = ''
      document.getElementById('cu-dj-dni').value = ''
      document.getElementById('cu-dj-acepto').checked = false
      const msg = document.getElementById('cu-dj-msg')
      msg.hidden = true
      msg.classList.remove('is-error')
      document.getElementById('cu-dj-modal').hidden = false
      padPreparar()
      padLimpiar()
      document.getElementById('cu-dj-doc').scrollTop = 0
    }
    // expuesto como los modales de la casa (window.showSociosTos)
    window.showFloraDdjj = abrirDdjj

    // ── el pad de la firma manuscrita: se dibuja con el dedo o el mouse y la
    //    imagen queda impresa en el documento sellado ──
    const pad = document.getElementById('cu-dj-firma')
    const padCtx = pad.getContext('2d')
    let padTrazos = 0
    let padDibujando = false
    function padPreparar() {
      const cs = pad.parentElement.getBoundingClientRect()
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      pad.width = Math.round(cs.width * dpr)
      pad.height = Math.round(150 * dpr)
      padCtx.scale(dpr, dpr)
      padCtx.lineWidth = 2.4
      padCtx.lineCap = 'round'
      padCtx.lineJoin = 'round'
      // tinta clara en pantalla (el modal es oscuro); al exportar se recolorea
      // a tinta oscura, que es como queda impresa en el documento
      padCtx.strokeStyle = '#e9e2f7'
    }
    function padLimpiar() {
      padCtx.clearRect(0, 0, pad.width, pad.height)
      padTrazos = 0
      document.getElementById('cu-dj-pad-guia').hidden = false
      document.getElementById('cu-dj-borrar').hidden = true
      validarDdjj()
    }
    function padPunto(e) {
      const r = pad.getBoundingClientRect()
      return [e.clientX - r.left, e.clientY - r.top]
    }
    pad.addEventListener('pointerdown', (e) => {
      e.preventDefault()
      pad.setPointerCapture(e.pointerId)
      padDibujando = true
      const [x, y] = padPunto(e)
      padCtx.beginPath()
      padCtx.moveTo(x, y)
      padCtx.lineTo(x + 0.1, y + 0.1) // el punto suelto también pinta
      padCtx.stroke()
      padTrazos++
      document.getElementById('cu-dj-pad-guia').hidden = true
      document.getElementById('cu-dj-borrar').hidden = false
      validarDdjj()
    })
    pad.addEventListener('pointermove', (e) => {
      if (!padDibujando) return
      const [x, y] = padPunto(e)
      padCtx.lineTo(x, y)
      padCtx.stroke()
    })
    ;['pointerup', 'pointercancel'].forEach((ev) => pad.addEventListener(ev, () => { padDibujando = false }))
    document.getElementById('cu-dj-borrar').addEventListener('click', padLimpiar)

    function padExportar() {
      const off = document.createElement('canvas')
      off.width = pad.width
      off.height = pad.height
      const o = off.getContext('2d')
      o.drawImage(pad, 0, 0)
      o.globalCompositeOperation = 'source-in'
      o.fillStyle = '#1c1633'
      o.fillRect(0, 0, off.width, off.height)
      return off.toDataURL('image/png')
    }

    // el botón de firmar recién se enciende con nombre + DNI + checkbox + firma dibujada
    function validarDdjj() {
      const ok = document.getElementById('cu-dj-nombre').value.trim().length > 0 &&
        document.getElementById('cu-dj-dni').value.replace(/\D/g, '').length >= 7 &&
        document.getElementById('cu-dj-acepto').checked &&
        padTrazos > 0
      document.getElementById('cu-dj-firmar').disabled = !ok
    }
    ;['cu-dj-nombre', 'cu-dj-dni'].forEach((id) => document.getElementById(id).addEventListener('input', validarDdjj))
    document.getElementById('cu-dj-acepto').addEventListener('change', validarDdjj)
    document.getElementById('cu-dj-cerrar').addEventListener('click', () => { document.getElementById('cu-dj-modal').hidden = true })
    document.getElementById('cu-dj-modal').addEventListener('click', (e) => {
      if (e.target.id === 'cu-dj-modal') document.getElementById('cu-dj-modal').hidden = true // clic afuera cierra
    })
    document.getElementById('cu-dj-firmar').addEventListener('click', firmarDdjj)

    async function firmarDdjj() {
      const btn = document.getElementById('cu-dj-firmar')
      const msg = document.getElementById('cu-dj-msg')
      btn.disabled = true
      btn.textContent = 'Firmando…'
      try {
        const r = await fetch('/api/socios/ddjj', {
          method: 'POST', credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            nombre_tipeado: document.getElementById('cu-dj-nombre').value,
            dni_tipeado: document.getElementById('cu-dj-dni').value,
            acepto: document.getElementById('cu-dj-acepto').checked,
            firma_imagen: padExportar(),
          }),
        })
        const d = await r.json().catch(() => ({}))
        btn.textContent = 'Firmar declaración'
        if (!r.ok) {
          msg.textContent = d.error || 'No se pudo firmar. Probá de nuevo.'
          msg.classList.add('is-error')
          msg.hidden = false
          btn.disabled = false
          return
        }
        msg.textContent = 'Firmada. El equipo la va a verificar y tu trámite sigue solo.'
        msg.classList.remove('is-error')
        msg.hidden = false
        setTimeout(() => {
          document.getElementById('cu-dj-modal').hidden = true
          cargarDdjj()
          cargarReprocann()
        }, 2600)
      } catch {
        msg.textContent = 'Error de red. Probá de nuevo.'
        msg.classList.add('is-error')
        msg.hidden = false
        btn.disabled = false
        btn.textContent = 'Firmar declaración'
      }
    }

    // Saldo de gramos (solo gramos — la plata no viaja hasta acá)
    async function cargarSaldo() {
      try {
        const res = await fetch('/api/socios/saldo', { credentials: 'include' })
        if (!res.ok) return
        const d = await res.json()
        if (!d.vinculado || !d.saldo) return
        const s = d.saldo
        document.getElementById('cu-saldo-g').textContent = `${s.saldo} g`
        document.getElementById('cu-saldo-det').textContent = s.base
          ? (s.tipo === 'plan' ? ` de ${s.base} g de tu plan`
             : s.tipo === 'debito' ? ` de ${s.base} g que tenés acumulados`
             : ` de ${s.base} g de este mes`)
          : ''
        // el plan por fin se ve: MEDIUM · 20 g/mes
        if (s.tier) {
          const chip = document.getElementById('cu-plan-chip')
          chip.textContent = s.tier.replace(/^PLAN\s+PLAN\s+/i, 'PLAN ') + (s.gramosMes ? ` · ${s.gramosMes} g/mes` : '')
          chip.hidden = false
        }
        const fill = document.getElementById('cu-saldo-fill')
        if (s.base > 0) fill.style.width = Math.min(100, ((s.base - s.saldo) / s.base) * 100).toFixed(1) + '%'
        document.getElementById('cu-saldo-sub').textContent = s.visitasMes
          ? `Retiraste ${s.retiradoMes} g en ${s.visitasMes} visita${s.visitasMes === 1 ? '' : 's'} este mes.`
          : (s.tipo === 'plan' && s.hasta ? `Tu plan vence en ${s.hasta.slice(0, 7)}.`
             : s.tipo === 'debito' && s.acumulado > s.saldo ? `Tenés ${s.acumulado} g acumulados. Podés llevarte hasta ${s.tope} g por visita.`
             : 'Todavía no retiraste este mes.')
        const aldia = document.getElementById('cu-aldia')
        if (s.tipo === 'contado') {
          aldia.textContent = s.alDia ? '✓ Cuota de este mes al día' : 'Este mes todavía no registramos tu cuota.'
          aldia.style.color = s.alDia ? '#3cb492' : '#e6a83e'
          aldia.hidden = false
        }
        // "socio desde" bajo el email
        if (d.desde) {
          const el = document.getElementById('cu-email')
          const mes = new Date(d.desde).toLocaleDateString('es-AR', { month: 'long', year: 'numeric' })
          if (mes && !el.textContent.includes('·')) el.textContent += ` · en el club desde ${mes}`
        }
        document.getElementById('cu-saldo-sec').hidden = false

        // Historial de retiros COMPLETO: flores en gramos y productos en
        // unidades (antes los aceites/cremas eran invisibles acá).
        const retiros = d.retiros || []
        if (retiros.length) {
          const fila = (r) => `<div><span>${esc(r.fecha.slice(8))}/${esc(r.fecha.slice(5, 7))}</span><span>${esc(r.producto || '')}</span><b>${r.gramos ? r.gramos + ' g' : (r.unidades || 1) + ' u.'}</b></div>`
          const caja = document.getElementById('cu-saldo-retiros')
          caja.innerHTML = retiros.slice(0, 6).map(fila).join('')
          const btn = document.getElementById('cu-vermas')
          if (retiros.length > 6) {
            btn.hidden = false
            btn.addEventListener('click', () => { caja.innerHTML = retiros.map(fila).join(''); btn.hidden = true }, { once: true })
          }
          document.getElementById('cu-retiros-sec').hidden = false
        }
      } catch { /* sin saldo no pasa nada: la sección queda oculta */ }
    }

    async function submitLogin(credential, tosAccept) {
      try {
        const res = await fetch('/api/socios/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ credential, tosAccept: !!tosAccept }),
        })
        const data = await res.json()
        if (res.ok && data.ok) {
          window.hideSociosTos()
          await cargar()
          return
        }
        if (data.needsTos) {
          window.showSociosTos({
            mode: 'accept',
            onAccept: () => submitLogin(credential, true),
          })
          return
        }
        const msg = document.getElementById('socios-login-msg')
        if (res.status === 403) {
          const wa = 'https://wa.me/5492996375723?text=' + encodeURIComponent('Hola Flora, quiero conocer el club 🌿')
          msg.innerHTML = `Todavía no estás en el padrón del club. <button type="button" class="sl-msg-cta" data-intent="acceso">Pedí tu acceso acá</button> y te contactamos, o escribinos por <a href="${wa}" target="_blank" rel="noopener">WhatsApp</a>.`
        } else {
          msg.textContent = data.error || 'No se pudo verificar tu cuenta.'
        }
        msg.hidden = false
      } catch {
        const msg = document.getElementById('socios-login-msg')
        msg.textContent = 'Error de red al verificar con Google.'
        msg.hidden = false
      }
    }

    window.handleGoogleCredential = (response) => submitLogin(response.credential, false)

    document.getElementById('cu-logout').addEventListener('click', async () => {
      await fetch('/api/socios/logout', { method: 'POST', credentials: 'include' })
      location.href = '/'
    })

    if (googleClientId) {
      window.onload = () => {
        google.accounts.id.initialize({ client_id: googleClientId, callback: window.handleGoogleCredential })
        google.accounts.id.renderButton(document.getElementById('g_id_button'), {
          width: 320,
          theme: 'filled_black', size: 'large', text: 'signin_with',
        })
      }
    }

    cargar()
  </script>

  <style is:global>
    html, body { background-color: #130d1c; }

    /* El portero de la recarga: el sello del loader de la primera visita, en
       su versión NOCTURNA. El papel blanco es el gesto cinematográfico de la
       home; adentro del portal la base es el violeta profundo de la casa, y el
       anillo (que en el PNG es violeta oscuro) se aclara por filtro a lavanda
       para lucir sobre el fondo. */
    .cu-portero {
      position: fixed; inset: 0; z-index: 80;
      display: flex; align-items: center; justify-content: center;
      background: radial-gradient(120% 90% at 50% 40%, #241733 0%, #150d22 55%, #0c0713 100%);
    }
    /* El display de autor le gana al display:none del atributo hidden: sin
       esta regla el velo quedaba puesto PARA SIEMPRE, para todo el mundo (y
       así se estrenó, colgado). La misma trampa ya está documentada en
       membresías. */
    .cu-portero[hidden] { display: none; }
    .cu-portero-anillo {
      width: clamp(150px, 34vw, 230px); height: clamp(150px, 34vw, 230px);
      display: grid; place-items: center;
    }
    .cu-portero-anillo img { grid-area: 1 / 1; width: 100%; height: 100%; object-fit: contain; }
    .cu-portero-leaf { filter: brightness(1.35) saturate(1.05); }
    .cu-portero-track { opacity: .18; filter: brightness(2.4); }
    .cu-portero-fill {
      filter: brightness(2.4) saturate(.85);
      --pct: 0;
      -webkit-mask-image: conic-gradient(from 180deg, #000 calc(var(--pct) * 1%), transparent 0);
              mask-image: conic-gradient(from 180deg, #000 calc(var(--pct) * 1%), transparent 0);
    }
    /* Iconos duotono HD — el idioma de membresías: continente en contorno,
       contenido en relleno, detalle fino solo en el aire del dibujo. */
    .fx-traz { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; opacity: 0.8; }
    .fx-lleno { fill: currentColor; stroke: none; opacity: 0.95; }
    .fx-fino { fill: none; stroke: currentColor; stroke-width: 1.1; stroke-linecap: round; stroke-linejoin: round; opacity: 0.5; }
    .fx-ico { width: 15px; height: 15px; vertical-align: -2px; }
    /* El saludo respira: más aire antes y después, la foto con su halo. */
    .cu-perfil { display: flex; align-items: center; gap: 18px; margin: clamp(22px, 3.5vw, 34px) 0 clamp(34px, 5vw, 48px); }
    .cu-foto {
      border-radius: 50%; border: 2px solid rgba(183, 157, 230, 0.4);
      box-shadow: 0 0 0 5px rgba(183, 157, 230, 0.08);
    }
    .cu-foto[hidden] { display: none; }
    .cu-email { color: rgba(244, 241, 247, 0.55); font-size: 0.9rem; margin: 4px 0 0; }

    /* Aire parejo entre secciones, y las volantas hablando todas igual: la
       misma volanta violeta de membresías, con una línea que se desvanece y
       ancla el título a su columna. */
    .cu-sec { margin-bottom: clamp(32px, 5vw, 46px); }
    .cu-sec-title {
      display: flex; align-items: center; gap: 14px;
      font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
      color: #b79de6; margin: 0 0 14px;
    }
    .cu-sec-title::after {
      content: ''; flex: 1; height: 1px;
      background: linear-gradient(90deg, rgba(183, 157, 230, 0.3), rgba(183, 157, 230, 0));
    }
    .cu-lista { display: flex; flex-direction: column; gap: 12px; }
    .cu-pedido {
      background: #1b1326; border: 1px solid rgba(183, 157, 230, 0.18);
      border-radius: 16px; padding: 17px 20px;
    }
    .cu-pedido.is-activo { border-color: rgba(79, 199, 158, 0.45); }
    .cu-pedido-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
    .cu-pedido-fecha { font-size: 0.82rem; color: rgba(244, 241, 247, 0.55); font-variant-numeric: tabular-nums; }
    .cu-pedido-items { font-size: 0.95rem; color: #f4f1f7; line-height: 1.55; margin: 0; }
    .cu-pedido-nota { font-size: 0.82rem; color: rgba(244, 241, 247, 0.55); margin: 8px 0 0; }
    .td-cart-badge.is-entregado { background: rgba(244, 241, 247, 0.12); color: rgba(244, 241, 247, 0.7); }
    .td-cart-badge.is-cancelado { background: rgba(255, 120, 120, 0.14); color: #ff9d9d; }
    /* El vacío también es una tarjeta, punteada: un lugar esperando contenido,
       no un renglón suelto. */
    .cu-vacio {
      color: rgba(244, 241, 247, 0.55); font-size: 0.92rem; margin: 0;
      border: 1px dashed rgba(183, 157, 230, 0.25); border-radius: 14px; padding: 16px 20px;
    }
    .cu-vacio a { color: #b79de6; font-weight: 700; text-decoration: none; }
    .cu-vacio a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .cu-vacio[hidden] { display: none; }
    .cu-gw { margin-top: 4px; }

    /* chips compartidos (plan y REPROCANN): la píldora de estado de membresías,
       en versalitas chicas. Verde = al día / aprobado, ámbar = te toca a vos. */
    .cu-chip { display: inline-flex; align-items: center; font-size: 0.68rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      padding: 5px 13px; border-radius: 999px; background: rgba(183, 157, 230, 0.12);
      color: #b79de6; border: 1px solid rgba(183, 157, 230, 0.3); white-space: nowrap; line-height: 1.4; }
    .cu-chip.is-ok { background: rgba(79, 199, 158, 0.14); color: #5ecfae; border-color: rgba(79, 199, 158, 0.35); }
    .cu-chip.is-vos { background: rgba(230, 168, 62, 0.12); color: #e6a83e; border-color: rgba(230, 168, 62, 0.35); }
    .cu-chip.is-mal { background: rgba(255, 120, 120, 0.12); color: #ff9d9d; border-color: rgba(255, 120, 120, 0.35); }
    .cu-chip[hidden] { display: none; }
    .cu-saldo-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

    /* tarjeta REPROCANN */
    .cu-rp-fila { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .cu-rp-vence { color: rgba(244, 241, 247, 0.6); font-size: 0.88rem; font-variant-numeric: tabular-nums; }
    /* El certificado es EL botón de esta tarjeta: panel verde con cuerpo,
       icono a la izquierda y hover que responde. */
    .cu-cert {
      display: block; margin-top: 16px; text-align: center; text-decoration: none;
      background: linear-gradient(155deg, rgba(79, 199, 158, 0.17), rgba(43, 138, 106, 0.08));
      border: 1px solid rgba(79, 199, 158, 0.42);
      border-radius: 14px; padding: 15px 18px; color: #f4f1f7; font-weight: 700; font-size: 0.95rem;
      transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
    }
    .cu-cert:hover {
      background: linear-gradient(155deg, rgba(79, 199, 158, 0.26), rgba(43, 138, 106, 0.14));
      border-color: rgba(79, 199, 158, 0.6);
      transform: translateY(-1px); box-shadow: 0 10px 26px rgba(0, 0, 0, 0.35);
    }
    .cu-cert .fx-ico { width: 19px; height: 19px; color: #5ecfae; vertical-align: -4px; margin-right: 5px; }
    .cu-cert small { display: block; color: rgba(244, 241, 247, 0.55); font-weight: 400; font-size: 0.78rem; margin-top: 2px; }
    .cu-cert[hidden] { display: none; }
    /* El turno es un pendiente del socio: mismo panel, en ámbar. */
    .cu-rp-turno {
      background: linear-gradient(155deg, rgba(230, 168, 62, 0.15), rgba(230, 168, 62, 0.05));
      border-color: rgba(230, 168, 62, 0.42);
    }
    .cu-rp-turno:hover {
      background: linear-gradient(155deg, rgba(230, 168, 62, 0.24), rgba(230, 168, 62, 0.1));
      border-color: rgba(230, 168, 62, 0.6);
    }
    .cu-rp-turno .fx-ico { color: #e6a83e; }
    /* Los "Ver … →" de la casa: peso 700 en el violeta institucional. */
    .cu-rp-ir { display: block; width: fit-content; margin-top: 14px; color: #b79de6; font-size: 0.86rem; font-weight: 700; text-decoration: none; }
    .cu-rp-ir:hover { text-decoration: underline; text-underline-offset: 3px; }

    /* editor de la reserva pendiente */
    .cu-ed-item { display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 10px 0; border-top: 1px solid rgba(244, 241, 247, 0.08); }
    .cu-ed-item:first-of-type { border-top: none; }
    .cu-ed-nombre { font-size: 0.95rem; color: #f4f1f7; }
    .cu-ed-nombre small { display: block; color: rgba(244, 241, 247, 0.45); font-size: 0.76rem; }
    .cu-ed-step { display: inline-flex; align-items: center; border: 1px solid rgba(183, 157, 230, 0.3);
      border-radius: 10px; overflow: hidden; }
    .cu-ed-step b { padding: 6px 12px; font-size: 0.9rem; min-width: 44px; text-align: center; }
    .cu-ed-step button { background: rgba(183, 157, 230, 0.1); border: none; color: #b79de6;
      font-size: 1.05rem; padding: 6px 12px; cursor: pointer; line-height: 1; }
    .cu-ed-step button:hover { background: rgba(183, 157, 230, 0.22); }
    .cu-ed-total { display: flex; justify-content: space-between; border-top: 1px dashed rgba(244, 241, 247, 0.15);
      margin-top: 10px; padding-top: 10px; font-size: 0.9rem; color: rgba(244, 241, 247, 0.6); }
    .cu-ed-total b { color: #f4f1f7; }
    .cu-ed-acciones { display: flex; justify-content: space-between; gap: 10px; margin-top: 14px; }
    .cu-ed-btn { border-radius: 999px; padding: 10px 18px; font-weight: 600; font-size: 0.85rem;
      cursor: pointer; font-family: var(--font-ui); }
    .cu-ed-btn.is-borrar { background: none; border: 1px solid rgba(255, 120, 120, 0.35); color: #ff9d9d; }
    .cu-ed-btn.is-borrar:hover { background: rgba(255, 120, 120, 0.1); }
    .cu-ed-btn.is-guardar { background: #b79de6; border: none; color: #1b1326; }
    .cu-ed-btn.is-guardar:disabled { opacity: 0.45; cursor: default; }

    .cu-vermas { display: block; width: 100%; margin-top: 14px; background: none;
      border: 1px solid rgba(183, 157, 230, 0.3); border-radius: 999px; color: #b79de6;
      padding: 10px; font-size: 0.82rem; font-weight: 700; cursor: pointer; font-family: var(--font-ui);
      transition: background 0.15s ease, border-color 0.15s ease; }
    .cu-vermas:hover { background: rgba(183, 157, 230, 0.1); border-color: rgba(183, 157, 230, 0.5); }
    .cu-vermas[hidden] { display: none; }
    #cu-retiros-sec[hidden] { display: none; }

    /* Las tarjetas grandes hablan el idioma de membresías: nocturno violeta
       con borde de familia. El plan lleva un aliento verde en su esquina (es
       la tarjeta de la plata en gramos), el REPROCANN uno violeta. */
    .cu-saldo-card {
      background: #1b1326; border: 1px solid rgba(183, 157, 230, 0.18);
      border-radius: 18px; padding: clamp(20px, 3vw, 26px) clamp(20px, 3.2vw, 28px);
    }
    #cu-saldo-sec .cu-saldo-card {
      background: radial-gradient(130% 130% at 0% 0%, rgba(79, 199, 158, 0.08), rgba(79, 199, 158, 0) 55%), #1b1326;
    }
    #cu-rp-sec .cu-saldo-card {
      background: radial-gradient(130% 130% at 0% 0%, rgba(183, 157, 230, 0.08), rgba(183, 157, 230, 0) 55%), #1b1326;
    }

    /* El saldo es EL número de la página: serif de la casa, con su eje óptico. */
    .cu-saldo-num { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
    .cu-saldo-num b {
      font-family: var(--font-display); font-optical-sizing: auto; font-weight: 500;
      font-size: clamp(2.9rem, 6vw, 3.6rem); line-height: 0.95; color: #4FC79E;
      letter-spacing: -0.01em; font-variant-numeric: tabular-nums;
    }
    .cu-saldo-num span { color: rgba(244, 241, 247, 0.55); font-size: 0.9rem; }
    .cu-saldo-bar { height: 9px; border-radius: 999px; background: rgba(244, 241, 247, 0.08); overflow: hidden; margin: 18px 0 12px; }
    .cu-saldo-bar i {
      display: block; height: 100%; width: 0; border-radius: 999px;
      background: linear-gradient(90deg, #2b8a6a, #4FC79E 70%, #7fe4bf);
      box-shadow: 0 0 14px rgba(79, 199, 158, 0.4);
      transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .cu-saldo-sub { color: rgba(244, 241, 247, 0.62); font-size: 0.88rem; line-height: 1.5; margin: 0 0 8px; }
    /* El aviso de la cuota ("al día" / "no registramos tu cuota") deja de ser
       un texto suelto: es una línea con cuerpo que toma el color que le pinta
       el JS (verde u ámbar) y arma su fondo y su borde desde currentColor. */
    #cu-aldia {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 0.8rem; font-weight: 600; line-height: 1.4;
      padding: 7px 13px; border-radius: 999px; margin: 2px 0 10px;
      border: 1px solid color-mix(in srgb, currentColor 38%, transparent);
      background: color-mix(in srgb, currentColor 11%, transparent);
    }
    #cu-aldia[hidden] { display: none; }

    /* Tus retiros: tabla fina. Fechas y gramos en cifras tabulares, los
       gramos a la derecha y en verde, separadores a media voz. */
    .cu-retiros-cab,
    .cu-saldo-retiros > div {
      display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: 12px;
      align-items: baseline;
    }
    .cu-retiros-cab {
      font-size: 0.64rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      color: rgba(244, 241, 247, 0.38); padding-bottom: 9px;
      border-bottom: 1px solid rgba(183, 157, 230, 0.18);
    }
    .cu-retiros-cab b { text-align: right; font-weight: 700; }
    .cu-saldo-retiros > div {
      padding: 9px 0; border-top: 1px solid rgba(244, 241, 247, 0.06);
      font-size: 0.88rem; font-variant-numeric: tabular-nums;
    }
    .cu-saldo-retiros > div:first-child { border-top: none; }
    .cu-saldo-retiros span:first-child { color: rgba(244, 241, 247, 0.45); }
    .cu-saldo-retiros span:nth-child(2) { color: rgba(244, 241, 247, 0.82); }
    .cu-saldo-retiros b { color: #4FC79E; font-weight: 600; text-align: right; white-space: nowrap; }
    #cu-saldo-sec[hidden] { display: none; }

    /* ── Declaración jurada ── */
    #cu-dj-sec[hidden] { display: none; }
    .cu-dj-intro { color: rgba(244, 241, 247, 0.62); font-size: 0.88rem; line-height: 1.55; margin: 12px 0 0; }
    /* El botón de firmar es el panel de acción de la tarjeta (idioma de
       .cu-cert), en la variante violeta de la casa. */
    .cu-dj-abrir {
      width: 100%; cursor: pointer; font-family: var(--font-ui);
      background: linear-gradient(155deg, rgba(183, 157, 230, 0.16), rgba(183, 157, 230, 0.05));
      border-color: rgba(183, 157, 230, 0.42);
    }
    .cu-dj-abrir:hover {
      background: linear-gradient(155deg, rgba(183, 157, 230, 0.25), rgba(183, 157, 230, 0.1));
      border-color: rgba(183, 157, 230, 0.6);
    }
    .cu-dj-abrir .fx-ico { color: #b79de6; }

    /* El modal habla el mismo idioma que el de términos (SociosTos): overlay
       nocturno con blur, tarjeta violeta de la casa. El documento adentro se
       lee como papel: serif, justificado, con su propio scroll. */
    .cu-dj-modal {
      position: fixed !important; inset: 0 !important; z-index: 60 !important;
      display: flex; align-items: center; justify-content: center;
      padding: 1rem;
      background: rgba(10, 6, 16, 0.7);
      backdrop-filter: blur(6px);
      font-family: var(--font-ui);
    }
    .cu-dj-modal[hidden] { display: none; }
    .cu-dj-modal-card {
      width: 100%; max-width: 680px; max-height: 92svh;
      overflow-y: auto;
      background: #1b1326;
      border: 1px solid rgba(183, 157, 230, 0.16);
      border-radius: 22px;
      padding: clamp(22px, 3.5vw, 34px);
      box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.9);
    }
    .cu-dj-title {
      font-family: var(--font-display); font-weight: 400;
      font-size: clamp(1.8rem, 4vw, 2.4rem); line-height: 1; margin: 0 0 0.4rem;
      color: #f4f1f7;
    }
    .cu-dj-title em { font-style: italic; color: #3cb492; }
    .cu-dj-meta { font-size: 0.75rem; color: rgba(244, 241, 247, 0.55); font-style: italic; margin: 0 0 1rem; }
    .cu-dj-doc {
      padding: 16px 12px 16px 18px; margin-bottom: 0.4rem;
      background: rgba(244, 241, 247, 0.04);
      border: 1px solid rgba(183, 157, 230, 0.16); border-radius: 12px;
      font-family: Georgia, 'Times New Roman', serif;
    }
    .cu-dj-doc-scroll { max-height: 36svh; overflow-y: auto; padding-right: 8px; }
    .cu-dj-doc h3 { font-size: 0.9rem; letter-spacing: 0.06em; text-align: center; color: #f4f1f7; margin: 0 0 2px; font-weight: 700; }
    .cu-dj-sub { text-align: center; font-size: 0.72rem; color: rgba(244, 241, 247, 0.5); margin: 0 0 14px !important; }
    .cu-dj-doc p { font-size: 0.85rem; line-height: 1.65; color: rgba(244, 241, 247, 0.75); text-align: justify; margin: 0 0 11px; }
    .cu-dj-cierre { margin-top: 6px; }
    .cu-dj-lab {
      display: block; font-size: 0.7rem; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase; color: #b79de6;
      margin: 0.95rem 0 0.35rem;
    }
    .cu-dj-input {
      width: 100%; box-sizing: border-box;
      background: rgba(244, 241, 247, 0.05);
      border: 1px solid rgba(183, 157, 230, 0.3); border-radius: 12px;
      color: #f4f1f7; font-family: var(--font-ui); font-size: 1rem; padding: 12px 14px;
    }
    .cu-dj-input:focus { outline: none; border-color: #b79de6; }
    .cu-dj-pad {
      position: relative; margin: 4px 0 14px; border: 1.5px dashed rgba(122, 92, 178, 0.55);
      border-radius: 10px; background: rgba(255, 255, 255, 0.045); overflow: hidden;
    }
    .cu-dj-pad canvas { display: block; width: 100%; height: 150px; touch-action: none; cursor: crosshair; }
    .cu-dj-pad-guia {
      position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none;
      color: rgba(235, 228, 248, 0.35); font-size: 14px; letter-spacing: 0.04em; font-style: italic;
    }
    .cu-dj-pad-borrar {
      position: absolute; top: 8px; right: 8px; font: inherit; font-size: 12px; padding: 4px 12px;
      border: 1px solid rgba(235, 228, 248, 0.25); border-radius: 999px; background: rgba(28, 22, 51, 0.75);
      color: rgba(235, 228, 248, 0.85); cursor: pointer;
    }

    .cu-dj-check {
      display: flex; align-items: flex-start; gap: 0.6rem;
      font-size: 0.88rem; font-weight: 600; color: #f4f1f7;
      margin-top: 1.05rem; padding-top: 0.9rem;
      border-top: 1px solid rgba(183, 157, 230, 0.16);
      cursor: pointer;
    }
    .cu-dj-check input { width: 18px; height: 18px; accent-color: #b79de6; flex-shrink: 0; cursor: pointer; margin-top: 1px; }
    .cu-dj-msg { font-size: 0.88rem; font-weight: 600; color: #3cb492; margin: 0.9rem 0 0; }
    .cu-dj-msg.is-error { color: #f2818a; }
    .cu-dj-msg[hidden] { display: none; }
    .cu-dj-actions { display: flex; justify-content: flex-end; gap: 0.7rem; margin-top: 1.3rem; flex-wrap: wrap; }
    .cu-dj-btn-primary {
      font-family: var(--font-ui); font-size: 0.88rem; font-weight: 700;
      border: none; border-radius: 999px; padding: 0.7rem 1.5rem;
      background: #b79de6; color: #130d1c;
      cursor: pointer; white-space: nowrap;
      transition: background 0.15s ease, transform 0.08s ease;
    }
    .cu-dj-btn-primary:hover { background: #c8b2ec; }
    .cu-dj-btn-primary:active { transform: scale(0.97); }
    .cu-dj-btn-primary:disabled { opacity: 0.5; cursor: default; }
    .cu-dj-btn-ghost {
      font-family: var(--font-ui); font-size: 0.88rem; font-weight: 700;
      border: 1px solid rgba(183, 157, 230, 0.16); border-radius: 999px; padding: 0.7rem 1.5rem;
      background: none; color: #f4f1f7;
      cursor: pointer; white-space: nowrap;
      transition: border-color 0.15s ease;
    }
    .cu-dj-btn-ghost:hover { border-color: #b79de6; }
  </style>
</Layout>
