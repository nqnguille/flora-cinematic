---
// Membresías de flores, para socios.
//
// No está enlazada en ningún menú y lleva noindex, pero eso NO es lo que la
// protege: la protege la sesión. Sin cookie de socio válida, acá no hay más
// que la pantalla de acceso, porque los precios los sirve
// /api/socios/precios, que exige sesión Y revalida contra el padrón (un socio
// dado de baja deja de verlos al instante, sin esperar a que expire nada).
//
// La lista se carga y se edita desde el panel, en Catálogo → Membresías: los
// números no viven acá.
import Layout from '../../layouts/Layout.astro'
import SociosLogin from '../../components/SociosLogin.astro'
import SociosTos from '../../components/SociosTos.astro'
import '../../styles/global.css'

const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || ''
---

<Layout
  title="Membresías — socios | Flora ONG"
  description="Planes de flores para socios de Flora."
  noindex={true}
>
  <link rel="stylesheet" href="/socios/tienda.css" />
  <main class="td-main">
    <div id="mb-portero" class="mb-portero" hidden aria-hidden="true">
      <div class="mb-portero-anillo">
        <img class="mb-portero-ring" src="/img/loader-ring.png" alt="" width="92" height="92" />
        <img class="mb-portero-leaf" src="/img/loader-leaf.png" alt="" width="42" height="42" />
      </div>
    </div>
    <script is:inline>
      // Síncrono a propósito: corre antes del primer paint de lo que sigue.
      try { if (localStorage.getItem('flora-socio-hint')) document.getElementById('mb-portero').hidden = false } catch (e) {}
    </script>

    <SociosLogin title="Acceso exclusivo para<br /><em class='sl-accent-green'>miembros del club</em>" joinPrompt>
      <Fragment slot="note">Validamos tu identidad en nuestra base de pacientes.<br />No compartimos tus datos.</Fragment>
    </SociosLogin>
    <SociosTos />

    <div id="mb-content" class="td-content" hidden>

      <!-- El video ya no es el fondo del encabezado sino el de la página
           entera: queda fijo detrás de todo y el contenido flota encima. El
           velo es lo que hace que el texto se lea; sin él, sobre hojas en
           movimiento no se lee nada a tres metros. -->
      <div class="mb-fondo" aria-hidden="true">
        <!-- "Cannabis plants swaying in the wind", de Nicky Pe (Pexels 12361112),
             ahora servido por NOSOTROS y horneado en ping-pong (ida + vuelta en
             el mismo archivo): los navegadores no reproducen en reversa, así
             que el rewind vive adentro del mp4 y el loop no tiene corte.
             Dos calidades: 1080 nítido para pantallas grandes (la TV lo cachea
             una vez), 720 liviano para el celular. El src lo elige el script de
             abajo ANTES de que el video empiece a cargar. -->
        <video data-src-hd="/video/membresias-1080.mp4"
               data-src-sd="/video/membresias-720.mp4"
               poster="https://images.pexels.com/videos/12361112/cannabis-cannabis-cultivation-cannabis-flower-field-12361112.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200"
               muted loop playsinline autoplay preload="none"></video>
        <script is:inline>
          (() => {
            const v = document.currentScript.previousElementSibling
            v.src = matchMedia('(min-width: 1200px)').matches ? v.dataset.srcHd : v.dataset.srcSd
          })()
        </script>
      </div>

      <!-- El logo respira solo a la izquierda; todos los controles, incluido
           el volver, van juntos a la derecha. -->
      <div class="td-head">
        <div class="td-brand">
          <img class="td-brand-logo" src="/img/flora-logo-white.png" alt="Flora" width="1472" height="298" />
          <span class="td-brand-name"><em>club</em></span>
        </div>
        <div class="mb-acciones">
          <a href="/socios/cuenta/" class="td-back mb-chip" id="mb-nav-cuenta">← Mi cuenta</a>
          <a class="mb-chip mb-chip--pri" id="mb-cta-carta" href="/socios/carta/"></a>
          <button id="mb-logout" class="td-logout mb-chip" type="button">Cerrar sesión</button>
        </div>
      </div>

      <!-- LA PRIMERA PANTALLA.
           Esto se muestra en la TV del living, donde nadie scrollea: tiene que
           entrar entero y bastarse solo. De 1200px para arriba se compone en
           una sola pantalla con tipografía de lejos; abajo de eso apila normal
           y el socio lo lee en el celular. Todo lo demás (el ciclo, los
           beneficios, las notas) queda debajo del pliegue a propósito.
           Referencia de la casa: /socios/carta, que ya es la pantalla de la TV. -->
      <div class="mb-primera">

      <!-- Hero con el video del sitio (421 KB) y el mismo velo oscuro que usa
           el resto de floraong.ar. La clase .reveal es el movimiento por
           defecto del sitio: IntersectionObserver, sin GSAP, y ya respeta
           prefers-reduced-motion desde el CSS global. -->
      <!-- Sin selector de forma de pago: la tarjeta ya muestra las dos, el
           contado arriba y el débito abajo como el beneficio que se desbloquea.
           Elegir de antemano era un paso que no decidía nada. -->
      <header class="mb-hero">
        <div class="mb-hero-txt">
          <div class="mb-hero-copy">
            <span class="mb-eyebrow" id="mb-eyebrow"></span>
            <h1 class="mb-title" id="mb-title"></h1>
            <p class="mb-lead" id="mb-lead"></p>
          </div>
          <!-- El sello legal, al lado del título: es lo primero que tiene que
               quedar claro en un TV que mira gente que todavía no es socia. -->
          <aside class="mb-sello">
            <span class="mb-sello-lb" id="mb-sello-lb">Ley 27.350 · REPROCANN</span>
            <!-- Los links legales viven DENTRO del párrafo, a continuación del
                 texto: una fila menos de alto en el sello. El JS pisa solo el
                 <span> del texto, los links quedan. -->
            <p class="mb-sello-txt"><span id="mb-sello-txt"></span>
              <a class="mb-sello-link" href="/#legalidad">Conocé el marco legal →</a>
              <a class="mb-sello-link" href="/terminos/">Términos y condiciones →</a></p>
          </aside>
        </div>
      </header>

      <p id="mb-vacio" class="mb-vacio" hidden>Todavía no hay membresías cargadas.</p>
      <p id="mb-aviso" class="mb-aviso" hidden></p>

      <div id="mb-grid" class="mb-grid"></div>
      <div class="mb-dots" id="mb-dots" aria-hidden="true"></div>

      <!-- Cierre en tres columnas: por qué conviene, cómo sigue, y la letra
           chica. Apilado ocupaba 1199 px de más y dejaba la página en 2,08
           pantallas de TV; en columnas usa el ancho, que es lo que sobra. -->
      <!-- Los degradés de los iconos 3D de la banda. Van UNA vez acá, en el
           HTML estático, porque los SVG que los usan los inyecta el JS y un
           url(#id) resuelve contra el documento entero. -->
      <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
          <linearGradient id="mbgV" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#dcccf6"/><stop offset=".45" stop-color="#B79DE6"/><stop offset="1" stop-color="#7a58b8"/></linearGradient>
          <linearGradient id="mbgVd" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8f6cc9"/><stop offset="1" stop-color="#503379"/></linearGradient>
          <linearGradient id="mbgG" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9df0cd"/><stop offset=".5" stop-color="#4FC79E"/><stop offset="1" stop-color="#2b8a6a"/></linearGradient>
          <linearGradient id="mbgC" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8fdcf9"/><stop offset="1" stop-color="#009EE3"/></linearGradient>
          <linearGradient id="mbgA" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffdf8e"/><stop offset=".5" stop-color="#ffb84d"/><stop offset="1" stop-color="#e88a12"/></linearGradient>
          <linearGradient id="mbgAd" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e89b2e"/><stop offset="1" stop-color="#a85c05"/></linearGradient>
          <linearGradient id="mbgR" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffb3a3"/><stop offset=".5" stop-color="#ff7a63"/><stop offset="1" stop-color="#d13f34"/></linearGradient>
          <linearGradient id="mbgRd" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#d95c4b"/><stop offset="1" stop-color="#8f2a22"/></linearGradient>
          <linearGradient id="mbgCr" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fffaf0"/><stop offset=".55" stop-color="#f3e8d2"/><stop offset="1" stop-color="#cdb98f"/></linearGradient>
          <linearGradient id="mbgGl" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ffffff" stop-opacity=".34"/><stop offset=".5" stop-color="#ffffff" stop-opacity=".08"/><stop offset="1" stop-color="#ffffff" stop-opacity=".22"/></linearGradient>
          <filter id="mbgS" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="1.6"/></filter>
        </defs>
      </svg>
      <div class="mb-cierre">

      <!-- El ciclo, con el patrón de pasos numerados de la home (número en
           serif verde sobre línea superior). Cuenta lo que hoy no se explicaba
           en ningún lado: qué pasa después de adherirse. -->
      <section class="mb-ciclo" id="mb-ciclo" hidden aria-label="Cómo funciona el débito">
        <header class="mb-sec-head">
          <h2 class="mb-h2" id="mb-ciclo-t">¿Cómo funciona?</h2>
        </header>
        <ul class="mb-items" id="mb-ciclo-items"></ul>
      </section>

      <section class="mb-beneficios" id="mb-beneficios" hidden>
        <header class="mb-sec-head">
          <h2 class="mb-h2" id="mb-benef-t">Beneficios exclusivos</h2>
        </header>
        <!-- Acá va el POR QUÉ, no el cómo: el cómo lo cuenta el ciclo de al lado.
             Antes esto convivía con una tira de tres frases arriba de las
             tarjetas que decía lo mismo con otras palabras, y con un cuarto
             paso del ciclo sobre los gramos que se acumulan: los tres decían
             una parte y ninguno pesaba. Quedó uno solo, en frases cortas,
             porque en la TV esto se lee a varios metros. -->
<ul class="mb-items" id="mb-benef-items"></ul>
      </section>


      </div><!-- /mb-cierre -->

      </div><!-- /mb-primera -->
    </div>
  </main>
</Layout>

<script src="https://accounts.google.com/gsi/client" async defer is:inline></script>

<script define:vars={{ googleClientId }}>
  const pesos = (n) => '$' + Number(n).toLocaleString('es-AR')
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c])

  let TX = {}   // todos los textos de la página, del backoffice
  let DTO = ''  // el descuento real, calculado de los precios
  let ACTUAL = { tier: null, debitoActivo: false, puede: false, motivo: null }
  let PLANES = []
  // El contado arranca seleccionado: es el precio de referencia. El descuento
  // no es "otro precio", es lo que se desbloquea al suscribirse al débito.

  function tarjeta(p) {
    const esMia = ACTUAL.tier && p.item === ACTUAL.tier
    // Un frasco por cada 10 g. El contorno solo se leía como envase vacío:
    // ahora lleva los cogollos adentro, en relleno, con el borde superior
    // festoneado. A 20px es lo único que se distingue de un frasco de aceite.
    const FRASCO = `<svg class="mb-frasco" viewBox="0 0 20 24" aria-hidden="true">
      <g class="mb-frasco-vidrio">
        <rect x="4.4" y="1.1" width="11.2" height="3.4" rx="1.2"/>
        <path d="M5.4 4.5h9.2a2.9 2.9 0 0 1 2.9 2.9v12.7a2.9 2.9 0 0 1-2.9 2.9H5.4a2.9 2.9 0 0 1-2.9-2.9V7.4a2.9 2.9 0 0 1 2.9-2.9Z"/>
      </g>
      <g class="mb-frasco-flor"><circle cx="6.8" cy="14.4" r="2.3"/><circle cx="10" cy="13.3" r="2.6"/><circle cx="13.2" cy="14.4" r="2.3"/><rect x="4.3" y="14.1" width="11.4" height="7.2" rx="2"/></g>
      <g class="mb-frasco-fino"><path d="M7.3 1.9v1.8M10 1.9v1.8M12.7 1.9v1.8"/></g>
    </svg>`
    const frascos = p.gramos
      ? `<p class="mb-frascos" aria-hidden="true">${FRASCO.repeat(Math.max(1, Math.min(6, Math.round(p.gramos / 10))))}</p>`
      : ''
    const detalle = p.gramos ? `<p class="mb-card-det">${p.gramos} gramos por mes</p>` : ''
    const ofreceDebito = !!(p.debito && p.linkDebito)
    // El botón se muestra siempre que la membresía tenga débito y el socio no
    // esté ya adherido. El estado del REPROCANN dejó de esconderlo: la
    // verificación pasó a ser un cartel DESPUÉS del clic. El servidor sigue
    // siendo el que decide (adherir.ts revalida y devuelve 409 con el motivo),
    // así que mostrarlo no habilita a nadie que no corresponda.
    const puedeBoton = ofreceDebito && !ACTUAL.debitoActivo
    const btn = puedeBoton
      ? `<button type="button" class="mb-adherir" data-tier="${esc(p.item)}"><span>${esc(TX.botonSuscribir || 'Suscribir con')}</span><img class="mb-adherir-mp" src="/img/mp-logo-full.png" alt="Mercado Pago" width="284" height="74" /></button>`
      : ''

    // El precio de referencia arriba, y el débito abajo como el beneficio que
    // se desbloquea, con su propio bloque. Antes había un selector que cambiaba
    // entre dos vistas; mostrar las dos juntas es lo que hace visible el salto.
    const gancho = ofreceDebito
      ? `<div class="mb-gancho">
          <span class="mb-gancho-lb">${esc(TX.etiquetaPrecio2 || 'Con débito automático')}</span>
          ${p.contado ? `<span class="mb-gancho-ahorro">${esc((TX.ahorro || 'ahorrás {monto}/mes').replace('{monto}', pesos(p.contado - p.debito)))}</span>` : ''}
          <b class="mb-gancho-precio">${pesos(p.debito)}</b>
          ${btn}
        </div>`
      : ''
    return `<article class="mb-card${esMia ? ' mb-card--mia' : ''}">
      <span class="mb-mia"${esMia ? '' : ' aria-hidden="true"'}>${esMia ? esc(TX.insigniaMia || 'Tu membresía') : ''}</span>
      ${frascos}
      <h3 class="mb-card-nom">${esc(p.item)}</h3>
      ${detalle}
      <p class="mb-card-precio">${pesos(p.contado)}<span>${esc(TX.etiquetaPrecio || 'Contado o transferencia')}</span></p>
      ${gancho}
    </article>`
  }

  function pintarPlanes() {
    document.getElementById('mb-grid').innerHTML = PLANES.map(tarjeta).join('')
    document.getElementById('mb-vacio').hidden = PLANES.length > 0
    // Los puntitos del slider del celular: uno por tarjeta, prendido el que
    // el snap dejó clavado. En pantallas grandes el CSS los esconde.
    const dots = document.getElementById('mb-dots')
    if (dots) {
      dots.innerHTML = PLANES.map(() => '<i></i>').join('')
      const riel = document.getElementById('mb-grid')
      const marcar = () => {
        const hijos = [...riel.children]
        if (!hijos.length) return
        const centro = riel.scrollLeft + riel.clientWidth / 2
        let mejor = 0, dist = Infinity
        hijos.forEach((c, i) => {
          const d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - centro)
          if (d < dist) { dist = d; mejor = i }
        })
        ;[...dots.children].forEach((p, i) => p.classList.toggle('act', i === mejor))
      }
      riel.addEventListener('scroll', marcar, { passive: true })
      marcar()
    }
    // Las dos columnas se muestran siempre. Antes se escondían cuando el
    // REPROCANN no estaba habilitado, junto con el botón: ahora que el botón
    // está siempre, esconder la explicación de qué es el débito dejaría la
    // pantalla mostrando precios sin decir de qué se trata. Es justo lo que
    // pasaba en el TV del living, que no tiene ficha de padrón propia.
    const dtos = PLANES
      .filter((p) => p.contado && p.debito && p.debito < p.contado)
      .map((p) => Math.round((1 - p.debito / p.contado) * 100))
    // El descuento sale de los precios reales, no de un texto escrito a mano:
    // si mañana cambian, el beneficio no miente. Se escribe {dto} en el texto
    // del backoffice y acá se reemplaza por el número.
    if (dtos.length) {
      const max = Math.max(...dtos)
      const parejo = dtos.every((d) => d === max)
      DTO = `${parejo ? '' : 'Hasta '}${max}%`
      pintarItems('mb-benef-items', TX.beneficios)
    }

    const ben = document.getElementById('mb-beneficios')
    if (ben) ben.hidden = false
    const cic = document.getElementById('mb-ciclo')
    if (cic) cic.hidden = false
  }

  // ── Los seis iconos de la banda de cierre ──
  // Dibujados a mano, no de una librería: tienen que hablar el mismo idioma
  // que el frasco de las tarjetas, que es lo único gráfico que ya había en la
  // página. La regla de ese idioma: el continente va en CONTORNO y el
  // contenido en RELLENO. Es el contraste entre los dos lo que hace que a
  // cuatro metros se lea una cosa llena y no un alambre.
  // Todos en un viewBox de 24x24 y con el trazo en currentColor, así el color
  // se decide una sola vez desde el CSS.
  const ico = (d) => `<svg class="mb-ico" viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`

  // Los cinco beneficios van en pseudo-3D a todo color, como los tiles de una
  // app: volúmenes con degradé, cara clara arriba a la izquierda, sombra de
  // apoyo abluada abajo. Cada beneficio tiene su color (violeta la renovación,
  // crema y verde la carta, coral el descuento, ámbar el envío, y el acumulado
  // guiña al celeste de MP), emparejados en tamaño óptico con el isotipo
  // oficial: el dibujo vive en la franja 8..40 del lienzo de 48.
  const ico3d = (d) => `<svg class="mb-ico" viewBox="0 0 48 48" aria-hidden="true"><ellipse cx="24" cy="41.6" rx="14" ry="2.6" fill="#000" opacity=".38" filter="url(#mbgS)"/>${d}</svg>`

  // 1 · Te suscribís con Mercado Pago → la billetera con las tarjetas
  //     asomando: el dibujo de su propio copy ("pagá con débito, crédito o
  //     dinero en cuenta"). El logo oficial de MP no se fue de la tarjeta:
  //     vive en el botón de suscribir, que es el momento donde sella confianza.
  const ICO_BILLETERA = ico3d(`
    <rect x="12" y="10" width="12" height="14" rx="2" fill="url(#mbgC)" transform="rotate(-12 18 17)"/>
    <rect x="18.6" y="8.6" width="12" height="14" rx="2" fill="url(#mbgR)" transform="rotate(-2 24.6 15.6)"/>
    <rect x="25" y="9.6" width="12" height="14" rx="2" fill="url(#mbgA)" transform="rotate(9 31 16.6)"/>
    <rect x="6.4" y="17.6" width="35.2" height="20" rx="3.4" fill="url(#mbgV)"/>
    <rect x="6.4" y="17.6" width="35.2" height="5.2" rx="2.6" fill="#fff" opacity=".14"/>
    <path d="M28.6 24h13v7.4h-13a3.7 3.7 0 0 1 0-7.4Z" fill="url(#mbgVd)"/>
    <circle cx="31" cy="27.7" r="1.8" fill="url(#mbgG)"/>
    <ellipse cx="12.4" cy="20.8" rx="3" ry="1.5" fill="#fff" opacity=".34" transform="rotate(-16 12.4 20.8)"/>`)

  // El concepto dejó de ser "renovación" (la flecha circular se leía como un
  //     reintento) y pasó a ser EL MES: un calendario con el cogollo puesto en
  //     su día, con su cerquito ámbar de "es hoy". Decidido el 07/08/2026.
  const ICO_MES = ico3d(`
    <rect x="15.2" y="7.6" width="3" height="7" rx="1.5" fill="url(#mbgVd)"/>
    <rect x="29.8" y="7.6" width="3" height="7" rx="1.5" fill="url(#mbgVd)"/>
    <rect x="10.8" y="10.8" width="26.4" height="25.6" rx="3.6" fill="url(#mbgV)"/>
    <path d="M10.8 14.4a3.6 3.6 0 0 1 3.6-3.6h19.2a3.6 3.6 0 0 1 3.6 3.6v3.8H10.8z" fill="url(#mbgVd)"/>
    <circle cx="17.6" cy="24" r="1.5" fill="#fff" opacity=".55"/>
    <circle cx="24" cy="24" r="1.5" fill="#fff" opacity=".55"/>
    <circle cx="30.4" cy="24" r="1.5" fill="#fff" opacity=".55"/>
    <circle cx="24" cy="30.6" r="1.5" fill="#fff" opacity=".55"/>
    <circle cx="30.4" cy="30.6" r="1.5" fill="#fff" opacity=".55"/>
    <circle cx="17.6" cy="30.6" r="4.4" fill="none" stroke="url(#mbgA)" stroke-width="1.7"/>
    <circle cx="16.2" cy="30.9" r="1.9" fill="#37a37f"/>
    <circle cx="19" cy="30.9" r="1.9" fill="#2e9273"/>
    <circle cx="17.6" cy="29.5" r="2" fill="url(#mbgG)"/>
    <ellipse cx="15.4" cy="13" rx="2.6" ry="1.2" fill="#fff" opacity=".35" transform="rotate(-16 15.4 13)"/>`)

  const ICO_CARTA = ico3d(`
    <rect x="14.2" y="9.4" width="18.6" height="26.4" rx="3.6" fill="#b7a279" transform="rotate(-21 23.5 40)"/>
    <rect x="14.2" y="9.4" width="18.6" height="26.4" rx="3.6" fill="#e3d5b3" transform="rotate(17 23.5 40)"/>
    <rect x="14.2" y="9.4" width="18.6" height="26.4" rx="3.6" fill="url(#mbgCr)" transform="rotate(-2 23.5 40)"/>
    <circle cx="20.4" cy="16.6" r="2.7" fill="url(#mbgG)"/>
    <circle cx="25.2" cy="15.3" r="3.1" fill="url(#mbgG)"/>
    <circle cx="28.2" cy="17.9" r="2.5" fill="url(#mbgG)"/>
    <rect x="18.2" y="16.2" width="11.8" height="5.2" rx="2.4" fill="url(#mbgG)" transform="rotate(-3 24.1 18.8)"/>
    <rect x="17.8" y="25.4" width="12" height="2.5" rx="1.25" fill="url(#mbgR)" transform="rotate(-3 23.8 26.6)"/>
    <rect x="18.3" y="29.8" width="7.8" height="2.5" rx="1.25" fill="#c9b890" opacity=".8" transform="rotate(-3 22.2 31)"/>
    <ellipse cx="18.4" cy="12.4" rx="2.7" ry="1.4" fill="#fff" opacity=".5" transform="rotate(-28 18.4 12.4)"/>`)

  const ICO_ETIQUETA = ico3d(`
    <path d="M26.2 9h9.4a3.1 3.1 0 0 1 3.1 3.1v9.4a3.1 3.1 0 0 1-.9 2.2L27 34.5a3.1 3.1 0 0 1-4.4 0l-8.7-8.7a3.1 3.1 0 0 1 0-4.4L24 10z" fill="url(#mbgRd)" transform="translate(1.4 1.7)"/>
    <path d="M26.2 9h9.4a3.1 3.1 0 0 1 3.1 3.1v9.4a3.1 3.1 0 0 1-.9 2.2L27 34.5a3.1 3.1 0 0 1-4.4 0l-8.7-8.7a3.1 3.1 0 0 1 0-4.4L24 10z" fill="url(#mbgR)"/>
    <circle cx="33.2" cy="14.4" r="2.7" fill="#7c221b"/>
    <circle cx="32.7" cy="13.9" r="1.8" fill="#511410"/>
    <path d="M33 10.6c.2-2.5 2.9-3.5 4.7-2.2" fill="none" stroke="url(#mbgCr)" stroke-width="1.5" stroke-linecap="round"/>
    <circle cx="21.2" cy="20.8" r="3" fill="url(#mbgCr)"/>
    <circle cx="27.4" cy="27" r="3" fill="url(#mbgCr)"/>
    <path d="M27.6 17.3l2.6 2.6-9 9-2.6-2.6z" fill="url(#mbgA)"/>
    <ellipse cx="20.3" cy="14.2" rx="3" ry="1.6" fill="#fff" opacity=".32" transform="rotate(-38 20.3 14.2)"/>`)

  const ICO_ENVIO = ico3d(`
    <rect x="6.4" y="13.8" width="19.6" height="16.6" rx="3" fill="url(#mbgA)"/>
    <rect x="6.4" y="13.8" width="19.6" height="5.6" rx="2.8" fill="#fff" opacity=".18"/>
    <path d="M26 19h6.8l5.7 6v5.4H26z" fill="url(#mbgAd)"/>
    <path d="M28 20.9h4l3.4 3.6H28z" fill="url(#mbgC)"/>
    <rect x="10.6" y="19.2" width="7.4" height="6.9" rx="1.6" fill="url(#mbgG)"/>
    <rect x="13.85" y="19.2" width="1.1" height="6.9" fill="#fff" opacity=".45"/>
    <circle cx="13.4" cy="32.2" r="4" fill="#241733"/><circle cx="13.4" cy="32.2" r="1.7" fill="#6b5390"/>
    <circle cx="32.4" cy="32.2" r="4" fill="#241733"/><circle cx="32.4" cy="32.2" r="1.7" fill="#6b5390"/>
    <path d="M3 17.4h2.1M2.5 21.8h2.6M3 26.2h2.1" stroke="#ffdf8e" stroke-width="1.6" stroke-linecap="round" opacity=".75"/>
    <ellipse cx="10.8" cy="16.1" rx="2.9" ry="1.4" fill="#fff" opacity=".36" transform="rotate(-18 10.8 16.1)"/>`)

  const ICO_ACUMULA = ico3d(`
    <rect x="16.4" y="8.4" width="13" height="4.9" rx="2" fill="url(#mbgVd)"/>
    <path d="M17.4 13.3h11a4.7 4.7 0 0 1 4.7 4.7v16.5a4.7 4.7 0 0 1-4.7 4.7h-11a4.7 4.7 0 0 1-4.7-4.7V18a4.7 4.7 0 0 1 4.7-4.7Z" fill="url(#mbgV)" opacity=".55"/>
    <circle cx="17.2" cy="35" r="3.1" fill="#2e9273"/>
    <circle cx="22.9" cy="35.6" r="3.4" fill="url(#mbgG)"/>
    <circle cx="28.6" cy="35" r="3.1" fill="#2e9273"/>
    <circle cx="15.9" cy="30.4" r="2.9" fill="url(#mbgG)"/>
    <circle cx="20.3" cy="30" r="3.2" fill="#37a37f"/>
    <circle cx="25.5" cy="30.2" r="3.3" fill="url(#mbgG)"/>
    <circle cx="29.9" cy="30.6" r="2.8" fill="#2e9273"/>
    <circle cx="18.3" cy="25.8" r="2.7" fill="#37a37f"/>
    <circle cx="23" cy="25" r="3" fill="url(#mbgG)"/>
    <circle cx="27.5" cy="25.9" r="2.6" fill="#37a37f"/>
    <circle cx="20.9" cy="28.6" r=".7" fill="#c8f5df"/>
    <circle cx="25.9" cy="33.8" r=".7" fill="#c8f5df"/>
    <circle cx="24.1" cy="23.6" r=".6" fill="#c8f5df"/>
    <rect x="15.1" y="15.2" width="1.4" height="21" rx=".7" fill="url(#mbgGl)"/>
    <circle cx="34.8" cy="14.6" r="6.1" fill="url(#mbgC)"/>
    <path d="M34.8 11.3v6.6M31.5 14.6h6.6" stroke="#fff" stroke-width="2.3" stroke-linecap="round"/>`)

  // Si el panel carga un ítem de más, ese cae acá y no rompe la fila.
  const ICO_FLOR = ico(`
    <g class="mb-ico-traz"><path d="M12 21.4v-6.6"/></g>
    <g class="mb-ico-lleno"><circle cx="8.4" cy="9.6" r="3.1"/><circle cx="15.6" cy="9.6" r="3.1"/><circle cx="12" cy="6.4" r="3.3"/><circle cx="12" cy="12.2" r="3.3"/></g>
    <g class="mb-ico-fino"><path d="M12 17.6l-1.6-1M12 17.6l1.6-1"/></g>`)

  // Los iconos van por posición dentro de su lista, no por el texto: el texto
  // se edita desde el backoffice y matchear por palabras sería adivinar.
  const ICONOS = {
    ciclo: [ICO_BILLETERA, ICO_MES, ICO_CARTA],
    beneficios: [ICO_ETIQUETA, ICO_ENVIO, ICO_ACUMULA],
  }

  // Las dos columnas del cierre se arman desde el backoffice: título +
  // pares de encabezado y descripción.
  function pintarItems(id, lista) {
    const ul = document.getElementById(id)
    if (!ul || !Array.isArray(lista)) return
    const conDto = (v) => String(v || '').replace('{dto}', DTO || '')
    // El grupo sale del id del <ul>, que es el único dato que ya reciben las
    // tres llamadas. Pasarlo por parámetro obligaba a tocar los tres lugares
    // para que digan lo mismo que el id que ya traen.
    const grupo = id.indexOf('benef') >= 0 ? 'beneficios' : 'ciclo'
    ul.innerHTML = lista.map((it, i) => `<li class="mb-item">
      ${ICONOS[grupo][i] || ICO_FLOR}
      <b class="mb-item-t">${esc(conDto(it.t))}</b>
      <span class="mb-item-d">${esc(conDto(it.d))}</span>
    </li>`).join('')
    // Los ítems pasaron de apilarse a ir uno al lado del otro: la lista necesita
    // tantas columnas como ítems tenga. Escrito acá y no clavado en 3, porque el
    // panel puede cargar un cuarto y ahí serían cuatro.
    ul.style.setProperty('--mb-cols', String(Math.max(1, lista.length)))
  }

  function pintar(d) {
    const tx = d.textos || {}
    TX = tx
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val || '' }
    // Barra de arriba y sello legal: hasta acá estaban escritos en el HTML,
    // así que cambiar una palabra pedía un deploy.
    set('mb-nav-cuenta', tx.navCuenta)
    set('mb-logout', tx.navSalir)
    set('mb-sello-lb', tx.selloLabel)
    set('mb-sello-txt', tx.selloTexto)
    set('mb-vacio', tx.vacio)
    // Las dos columnas del cierre
    set('mb-ciclo-t', tx.cicloTitulo)
    set('mb-benef-t', tx.beneficiosTitulo)
    pintarItems('mb-ciclo-items', tx.ciclo)
    pintarItems('mb-benef-items', tx.beneficios)
    // Acá se calculaban los renglones compartidos de la banda de cierre a
    // partir de cuántos ítems tenía la lista más larga, porque los ítems iban
    // apilados. Ahora van en fila y los renglones son siempre los mismos tres
    // (ícono, título, descripción), sin importar cuántos ítems haya: lo que
    // pasó a depender del contenido son las COLUMNAS, y eso lo escribe
    // pintarItems sobre cada lista.
    set('mb-eyebrow', tx.eyebrow)
    const tit = document.getElementById('mb-title')
    tit.textContent = tx.titulo || ''
    if (tx.tituloEm) {
      const em = document.createElement('em')
      em.textContent = ' ' + tx.tituloEm
      tit.appendChild(em)
    }
    set('mb-lead', tx.lead)

    ACTUAL = d.actual || { tier: null, debitoActivo: false }

    PLANES = Array.isArray(d.planes) ? d.planes : []
    pintarPlanes()

    // Quien no puede adherirse ve POR QUÉ y adónde ir. Un botón que
    // simplemente no está deja a la persona sin saber qué le falta.
    const av = document.getElementById('mb-aviso')
    if (ACTUAL.debitoActivo) {
      av.innerHTML = 'Ya tenés el débito automático activo. Para cambiar de membresía, escribinos.'
      av.hidden = false
    } else { av.hidden = true }

    // La columna de letra chica se sacó de la página: lo legal vive ahora en
    // el sello del encabezado. Los textos siguen guardados en el backoffice
    // por si se quiere volver a mostrar.
    set('mb-cta-carta', tx.ctaCarta)
    // En el celular el sello legal baja: primero los precios, después el
    // marco. En el DOM vive en el hero (la TV lo quiere arriba), así que se
    // muda una sola vez acá.
    if (matchMedia('(max-width: 767px)').matches) {
      const sello = document.querySelector('.mb-sello')
      const cierre = document.querySelector('.mb-cierre')
      if (sello && cierre && sello.nextElementSibling !== cierre) cierre.before(sello)
    }
  }

  // Un click: se registra la adhesión y se abre el checkout de Mercado Pago.
  // Cartel de verificación: aparece cuando el socio aprieta y el servidor
  // dice que todavía no puede. Reemplaza al aviso que antes salía ANTES, con
  // el botón escondido: quien mira la pantalla del living ve la oferta
  // completa, y el que la aprieta se entera de qué le falta.
  function verificacion(motivo) {
    const wa = 'https://wa.me/5492996375723?text=' + encodeURIComponent('Hola Flora, quiero adherirme al débito automático')
    let ov = document.getElementById('mb-verif')
    if (!ov) {
      ov = document.createElement('div')
      ov.id = 'mb-verif'
      ov.className = 'mb-verif'
      ov.innerHTML = `
        <div class="mb-verif-card" role="dialog" aria-modal="true" aria-labelledby="mb-verif-t">
          <div class="mb-verif-txt">
            <span class="mb-verif-lb" id="mb-verif-t">${esc(TX.verifTitulo || 'Antes de suscribirte')}</span>
            <p class="mb-verif-p"></p>
          </div>
          <div class="mb-verif-acc">
            <a class="mb-chip mb-chip--pri" href="/socios/reprocann/">${esc(TX.verifTramite || 'Ver mi trámite')}</a>
            <a class="mb-chip" href="${wa}" target="_blank" rel="noopener noreferrer">${esc(TX.verifEscribinos || 'Escribinos')}</a>
            <button type="button" class="mb-chip" data-cerrar>${esc(TX.verifCerrar || 'Cerrar')}</button>
          </div>
        </div>`
      document.getElementById('mb-content').appendChild(ov)
      ov.addEventListener('click', (e) => {
        if (e.target === ov || e.target.hasAttribute('data-cerrar')) ov.hidden = true
      })
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') ov.hidden = true })
    }
    ov.querySelector('.mb-verif-p').textContent = motivo
    ov.hidden = false
    ov.querySelector('[data-cerrar]').focus()
  }

  async function adherir(btn) {
    const tier = btn.dataset.tier
    btn.disabled = true
    const original = btn.textContent
    btn.textContent = 'Abriendo…'
    try {
      const r = await fetch('/api/socios/adherir', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tier }),
      })
      const d = await r.json().catch(() => ({}))
      if (r.ok && d.ok && d.link) { location.href = d.link; return }
      // El servidor rechazó: se muestra su motivo como un cartel, no como un
      // error suelto arriba de la página que en la TV nadie ve.
      verificacion(d.error || 'No se pudo abrir la adhesión. Escribinos y lo resolvemos.')
    } catch {
      verificacion('No se pudo conectar. Probá de nuevo.')
    }
    btn.disabled = false
    btn.textContent = original
  }

  document.addEventListener('click', (e) => {
    const b = e.target.closest('.mb-adherir')
    if (b) { adherir(b); return }
  })

  // La vuelta de Mercado Pago: /api/socios/volviste redirige acá con
  // ?adherido. Se celebra, se limpia la URL, y el estado real igual lo trae
  // la API (debitoActivo) al cargar.
  const vuelta = new URLSearchParams(location.search).get('adherido')
  if (vuelta) {
    history.replaceState(null, '', location.pathname)
    const av = document.getElementById('mb-aviso')
    if (av) {
      av.hidden = false
      av.classList.add('mb-aviso--ok')
      av.textContent = vuelta === 'pendiente'
        ? 'Tu adhesión quedó registrada y espera la aprobación de Mercado Pago. Apenas se confirme, la vas a ver acá.'
        : '¡Listo! Tu débito automático quedó activo: tus gramos se habilitan solos cada mes.'
    }
  }

  const portero = document.getElementById('mb-portero')
  // Red de seguridad: si la red se cuelga, el velo no puede ser una trampa.
  setTimeout(() => { if (portero) portero.hidden = true }, 6000)

  async function cargar() {
    // Sin sesión válida no se pinta nada: queda la pantalla de acceso. La
    // marquita se borra para que la próxima recarga muestre el login directo.
    const yoRes = await fetch('/api/socios/yo', { credentials: 'include' })
    if (!yoRes.ok) {
      try { localStorage.removeItem('flora-socio-hint') } catch (e) {}
      if (portero) portero.hidden = true
      return false
    }
    try { localStorage.setItem('flora-socio-hint', '1') } catch (e) {}

    // Una sola llamada trae todo: los textos (editables en el panel), los
    // planes de la lista de precios vigente y en qué situación está el socio.
    const res = await fetch('/api/socios/membresias', { credentials: 'include' })
    const d = res.ok ? await res.json().catch(() => null) : null
    if (d?.ok) pintar(d)

    document.getElementById('socios-login').hidden = true
    document.getElementById('mb-content').hidden = false
    if (portero) portero.hidden = true
    return true
  }

  // Mismo flujo de acceso que /socios/cuenta: Google, aceptación de términos
  // y el mensaje de "todavía no estás en el padrón" con el formulario a mano.
  async function submitLogin(credential, tosAccept) {
    try {
      const res = await fetch('/api/socios/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ credential, tosAccept: !!tosAccept }),
      })
      const data = await res.json()
      if (res.ok && data.ok) {
        window.hideSociosTos()
        await cargar()
        return
      }
      if (data.needsTos) {
        window.showSociosTos({ mode: 'accept', onAccept: () => submitLogin(credential, true) })
        return
      }
      const msg = document.getElementById('socios-login-msg')
      if (res.status === 403) {
        const wa = 'https://wa.me/5492996375723?text=' + encodeURIComponent('Hola Flora, quiero conocer el club 🌿')
        msg.innerHTML = `Todavía no estás en el padrón del club. <button type="button" class="sl-msg-cta" data-intent="acceso">Pedí tu acceso acá</button> y te contactamos, o escribinos por <a href="${wa}" target="_blank" rel="noopener">WhatsApp</a>.`
      } else {
        msg.textContent = data.error || 'No se pudo verificar tu cuenta.'
      }
      msg.hidden = false
    } catch {
      const msg = document.getElementById('socios-login-msg')
      msg.textContent = 'Error de red al verificar con Google.'
      msg.hidden = false
    }
  }

  window.handleGoogleCredential = (response) => submitLogin(response.credential, false)

  document.getElementById('mb-logout').addEventListener('click', async () => {
    await fetch('/api/socios/logout', { method: 'POST', credentials: 'include' })
    location.href = '/'
  })

  if (googleClientId) {
    window.onload = () => {
      google.accounts.id.initialize({ client_id: googleClientId, callback: window.handleGoogleCredential })
      google.accounts.id.renderButton(document.getElementById('g_id_button'), {
        width: 320, theme: 'filled_black', size: 'large', text: 'signin_with',
      })
    }
  }

  cargar()
</script>

<style is:global>
  html, body { background-color: #130d1c; }

  /* Estas piezas las escribe el JS con el contenido que viene del panel, así
     que NO pueden ir en el bloque scoped: Astro le pone su atributo de alcance
     solo a lo que existe al compilar, y el HTML inyectado se quedaba sin
     estilo. */
  /* Sobre el video una tarjeta al 4% de blanco es literalmente transparente y
     el precio se pierde entre las hojas. Va oscura y sólida: el video se ve
     alrededor, no atrás del número. */
  .mb-card {
    background: rgba(14, 9, 21, 0.86);
    border: 1px solid rgba(183, 157, 230, 0.22);
    border-radius: 18px; padding: 22px 20px; text-align: center; position: relative;
  }
  /* Del rediseño de agosto sobrevivió UNA sola suba de tamaño: la del nombre
     (13 → 17px acá, 21 → 31px en la TV). El resto (precio, frascos, renglones)
     volvió a su medida anterior: agrandado todo junto, nada era protagonista y
     la tarjeta gritaba. */
  .mb-card-nom {
    font-family: var(--font-ui); font-size: 17px; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase;
    color: rgba(244, 241, 247, 0.9); margin: 0 0 6px;
  }
  .mb-card-det {
    font-family: var(--font-ui); font-size: 13.5px;
    color: rgba(244, 241, 247, 0.55); margin: 0 0 14px;
  }
  .mb-card-precio {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(26px, 4vw, 32px);
    color: #4FC79E; margin: 0; line-height: 1.1;
    /* Source Serif 4 trae eje óptico: a tamaño grande afina los remates sola. */
    font-optical-sizing: auto;
  }
  .mb-card-precio span {
    display: block; font-family: var(--font-ui); font-size: 12px;
    color: rgba(244, 241, 247, 0.45); margin-top: 4px;
  }
  .mb-card--mia { border-color: rgba(60, 180, 146, .55); background: rgba(14, 30, 26, .8); }
  /* El chip se renderiza SIEMPRE, vacío cuando no corresponde: así reserva el
     mismo alto en las cuatro tarjetas y no desalinea la marcada. */
  /* La insignia se posa sobre la tarjeta en vez de ocupar un renglón. Antes
     el chip VACÍO de las otras tres tarjetas seguía midiendo alto para que
     todas alinearan, y ese era el aire de más que quedaba arriba de los
     frascos. Con la insignia fuera del flujo, el problema se va solo. */
  .mb-mia {
    position: absolute; top: 9px; right: 11px;
    font-family: var(--font-ui); font-size: 9.5px; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: #4FC79E;
    background: rgba(60, 180, 146, .16); border: 1px solid rgba(79, 199, 158, .3);
    border-radius: 999px; padding: 3px 9px; line-height: 1.2;
  }
  .mb-mia:empty { display: none; }

  .mb-adherir {
    /* Se ajusta al texto en vez de ocupar todo el ancho: la tarjeta ya está
       centrada, así que inline-flex lo centra solo. */
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    width: auto; margin-top: 14px;
    font: inherit; font-family: var(--font-ui); font-size: 13px; font-weight: 700;
    color: #1c1626; background: #fff; border: 0; border-radius: 999px;
    padding: 10px 14px; cursor: pointer;
  }
  /* En la tarjeta angosta del celular, el texto partía en dos renglones y el
     botón crecía al doble de alto. */
  .mb-adherir span { white-space: nowrap; }
  .mb-adherir-mp { height: 15px; width: auto; display: block; flex: none; }
  .mb-adherir:hover { filter: brightness(.94); }
  .mb-adherir:disabled { opacity: .6; cursor: default; }
  /* El bloque que desbloquea el descuento. Va con el celeste de Mercado Pago
     para que se lea como "esto es lo que pasa si te suscribís", separado del
     precio de referencia de arriba. */
  .mb-gancho {
    margin: 16px 0 0; padding: 13px 12px 14px;
    background: rgba(0, 158, 227, .09);
    border: 1px solid rgba(0, 158, 227, .28);
    border-radius: 14px;
  }
  .mb-gancho-lb {
    display: block; font-family: var(--font-ui); font-size: 10.5px; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: #4cb8e8; margin-bottom: 4px;
  }
  .mb-gancho-precio {
    display: block; font-family: var(--font-display); font-weight: 600;
    font-size: 27px; color: #f4f1f7; line-height: 1.1;
  }
  /* El ahorro en píldora verde sólida con letra oscura, ARRIBA del precio de
     débito: primero la noticia, después el número. El contado no se repite
     tachado acá: ya está en grande dos renglones más arriba. */
  .mb-gancho-ahorro {
    display: inline-block; font-family: var(--font-ui); font-size: 10.5px; font-weight: 800;
    letter-spacing: .03em; text-transform: uppercase;
    color: #08160f; background: linear-gradient(135deg, #63d9ae, #3cb492);
    border-radius: 999px; padding: 4px 11px; margin: 2px 0 6px;
  }
  .mb-gancho .mb-adherir { margin-top: 11px; }

  /* ── Frascos ──
     Este bloque tiene que quedar ARRIBA de los @media de celular de más abajo.
     Estaba después, y como tiene la misma especificidad que los overrides de
     560 y 400, ganaba por orden: en el teléfono los frascos se seguían pintando
     del tamaño de escritorio aunque el override dijera otra cosa. Era un bug
     viejo, de cuando el bloque se escribió al final del archivo. */
  /* Frasquitos: uno por cada 10 g, en VIOLETA, el segundo color de la marca.
     El reparto: el VERDE es la plata (los precios), el VIOLETA
     es lo que se lleva el socio y el marco legal. */
  .mb-frascos {
    display: flex; justify-content: center; align-items: flex-end;
    gap: 5px; margin: 0 0 7px;
  }
  .mb-frasco { width: 22px; height: 26px; flex: none; color: #B79DE6; }
  /* El vidrio va en contorno y el contenido en relleno: es el contraste entre
     los dos lo que hace que se lea lleno y no como un envase suelto. */
  .mb-frasco-vidrio { fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linejoin: round; stroke-linecap: round; opacity: .8; }
  .mb-frasco-flor { fill: currentColor; stroke: none; opacity: .95; }
