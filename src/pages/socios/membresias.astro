      rgba(19, 13, 28, .12);
  }
  /* Todo el contenido flota por encima del fondo fijo. */
  #mb-content > *:not(.mb-fondo) { position: relative; z-index: 1; }
  @media (prefers-reduced-motion: reduce) {
    .mb-fondo video { display: none; }
    .mb-fondo { background: #130d1c url('https://images.pexels.com/videos/12361112/cannabis-cannabis-cultivation-cannabis-flower-field-12361112.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200') center / cover; }
  }

  .mb-hero { margin: 0 0 var(--mb-v4); position: relative; }
  /* ── La cama oscura del título, versión definitiva ──
     Antes era una caja rectangular colgada del hero, y quedó corrida TRES
     veces: cada vez que el título se movía (subir el hero, flotar la volanta,
     centrar el logo), la caja seguía anclada a la geometría vieja. Ahora es
     una ELIPSE RADIAL pegada al propio bloque de texto (.mb-hero-copy):
     - se mueve con el texto, no puede quedar desalineada;
     - su borde se desvanece a cero en TODAS las direcciones: no hay canto
       visible que pueda delatar una posición, ni sobre fondo claro;
     - termina donde termina el bloque, así nunca se mete debajo del badge
       legal ni detrás de las tarjetas. */
  /* Acá vivió, en cuatro versiones distintas, la "cama oscura" del título:
     una caja, después una caja más chica, después una elipse. TODAS quedaron
     desalineadas alguna vez, porque una forma dibujada cerca del texto
     siempre tiene una posición que puede envejecer. Se eliminó de raíz: la
     legibilidad ahora la dan el velo global del video (más cargado arriba,
     una banda uniforme de borde a borde que no tiene posición) y las sombras
     de las propias letras, que viajan pegadas a los glifos. */
  .mb-hero-copy { position: relative; }
  .mb-hero-txt { position: relative; z-index: 1; }
  /* En el celular el selector va debajo del texto; en pantalla grande comparten
     renglón (regla más abajo, en el bloque de TV). */

  .mb-eyebrow {
    display: inline-block; font-family: var(--font-ui);
    font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
    color: #4FC79E; margin-bottom: var(--mb-v1);
  }
  .mb-title {
    font-family: var(--font-display); font-weight: 600; font-optical-sizing: auto;
    font-size: clamp(30px, 6vw, 48px); line-height: 1.12;
    color: #f4f1f7; margin: 0 0 var(--mb-v2); text-wrap: balance;
  }
  /* "de flores" va en itálica CREMA, no en verde: decidido mirando las dos
     versiones. Acá había una regla que le ponía el verde y que nunca aplicó
     (el <em> lo crea el JS después de compilar, así que no lleva el atributo
     de alcance de Astro). La itálica que se ve es la del navegador y alcanza.
     Borrada para que el código no diga una cosa distinta de la que se ve. */
  /* Sobre una foto, un párrafo al 66% de opacidad se pierde entre las hojas.
     La sombra sola no alcanza cuando el fondo tiene zonas claras. */
  .mb-lead {
    font-family: var(--font-ui); font-size: 16.5px; line-height: 1.6;
    color: rgba(248, 246, 252, 0.9); margin: 0;
  }

  /* Sobre video el texto necesita sombra sí o sí, igual que en el resto del
     sitio: 0 2px 28px para títulos, 0 1px 16px para párrafos. Ahora que el
     video es el fondo de todo, esto vale para toda la página, no solo el hero. */
  .mb-title { text-shadow: 0 1px 4px rgba(0, 0, 0, .6), 0 3px 30px rgba(0, 0, 0, .75); }
  .mb-lead, .mb-h2 { text-shadow: 0 1px 3px rgba(0, 0, 0, .85), 0 2px 20px rgba(0, 0, 0, .8); }
  .mb-eyebrow { text-shadow: 0 1px 3px rgba(0, 0, 0, .85), 0 1px 14px rgba(0, 0, 0, .75); }

  /* Encabezado de sección interna, con el gesto tipográfico del sitio: el
     título partido y la segunda mitad en verde. */
  /* Centrado, igual que las tarjetas: la banda de abajo habla el mismo idioma
     que la de arriba. El margin auto importa: sin él la caja de 720px se
     apoyaba a la izquierda y el texto se centraba dentro de ELLA, no dentro de
     la columna, así que en tablet quedaba corrido a la izquierda. */
  .mb-sec-head { max-width: 720px; margin: 0 auto var(--mb-v2); text-align: center; }
  /* Serif, como el título del hero y como todo el portal de socios. En la home
     los títulos son sans 800, pero acá adentro la voz es la otra. */
  .mb-h2 {
    font-family: var(--font-display); font-weight: 600; font-optical-sizing: auto;
    font-size: clamp(27px, 3.8vw, 42px); line-height: 1.12;
    color: #fff; margin: 0; text-wrap: balance;
  }

  /* ── Cierre: apilado en el celular, tres columnas en pantalla grande ── */
  /* El margin-top no vivía acá sino solo en el bloque de TV, así que en el
     celular "¿Cómo funciona?" arrancaba PEGADO al borde de la última tarjeta:
     .mb-grid no trae margen abajo y el gap de esta grilla separa a las dos
     secciones entre sí, no a la banda de lo que tiene arriba. */
  .mb-cierre {
    display: grid; gap: var(--mb-v4); margin-top: var(--mb-v4);
    /* Centrado por herencia y no ítem por ítem: los <li> los escribe el JS y no
       llevan el atributo de alcance de Astro, así que una regla sobre .mb-item
       desde acá no los tocaría. text-align sí baja solo. */
    text-align: center;
  }
  /* Las tres traían su propio aire, su ancho máximo y su línea de separación,
     de cuando cada una era una sección suelta al final de la página. Apiladas
     eso las separaba; en columnas las hacía arrancar a distinta altura, cada
     una con su rayita. Adentro de la banda el aire y la línea los pone la
     grilla, una sola vez. */
  .mb-cierre > * { max-width: none; margin: 0; padding-top: 0; border-top: 0; }

  /* Acá vivía un bloque huérfano: cuatro reglas sueltas y una llave de más,
     resto de una edición anterior que quedó cortada. Estaban duplicadas dentro
     del @media de TV de más abajo, y la llave sobrante desbalanceaba la hoja. */

  .mb-grid {
    display: grid; gap: var(--mb-v2); margin: 0 auto;
    /* Siempre dos columnas abajo de 1200px, sin importar el ancho del
       teléfono: con auto-fit, un teléfono de 360 no llegaba al mínimo de
       170px por tarjeta y se caía a una sola columna, o sea 2,6 pantallas de
       scroll para ver los cuatro planes. Arriba de 1200 el bloque de TV lo
       pisa con cuatro. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .mb-aviso {
    max-width: 620px; margin: 0 auto var(--mb-v3); text-align: center;
    font-family: var(--font-ui); font-size: 13.5px; line-height: 1.6;
    color: rgba(244, 241, 247, 0.72);
    background: rgba(255, 255, 255, .04); border: 1px solid rgba(183, 157, 230, .18);
    border-radius: 12px; padding: 12px 16px;
  }
  .mb-aviso :global(b) { color: rgba(244, 241, 247, 0.92); }

  /* El portero de la recarga: mismo lenguaje que el loader de la home. */
  .mb-portero {
    position: fixed; inset: 0; z-index: 80;
    display: grid; place-items: center;
    background: #0c0713;
  }
  .mb-portero-anillo { position: relative; width: 92px; height: 92px; }
  .mb-portero-ring { width: 100%; height: 100%; animation: mb-girar 1.1s linear infinite; opacity: .85; }
  .mb-portero-leaf { position: absolute; inset: 0; margin: auto; width: 42px; height: auto; }
  @keyframes mb-girar { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .mb-portero-ring { animation: none; } }
  /* La vuelta feliz de Mercado Pago: mismo cartel, en verde. */
  .mb-aviso--ok {
    border-color: rgba(79, 199, 158, .45); background: rgba(14, 62, 48, .35);
    color: rgba(244, 241, 247, .9); font-weight: 600;
  }
  .mb-aviso :global(a) { color: #4FC79E; font-weight: 700; text-underline-offset: 3px; }
  .mb-vacio {
    text-align: center; font-family: var(--font-ui); font-size: 14px;
    color: rgba(244, 241, 247, 0.5); margin: 0 0 var(--mb-v3);
  }

  /* Los accesos viven arriba, al lado de Cerrar sesión: son navegación, no el
     cierre de la lectura. Antes colgaban del final de la tercera columna, que
     los dejaba a merced de cuánto texto tuviera esa columna. */
  .mb-acciones { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-left: auto; }
  /* Un solo chip para los cuatro accesos del encabezado. Antes "Mi cuenta" era
     un link pelado, "Cerrar sesión" un chip de tienda.css y los dos CTA otro
     chip más chico: cuatro cosas del mismo rango con tres formas distintas.
     El id gana la especificidad contra tienda.css sin pelear con !important. */
  /* Los chips van sobre una FOTO, no sobre un color: en la franja del
     encabezado el fondo va del negro al blanco puro. Un borde traslúcido ahí
     aparece y desaparece según la hoja que le toque atrás, y el chip se ve
     roto. Por eso llevan su propio fondo oscuro con desenfoque: se despegan
     de la imagen siempre, sin importar qué haya debajo. */
  /* :global() a propósito: los tres chips del cartel de verificación los
     escribe el JS y no llevan el atributo de alcance de Astro, así que con el
     selector con scope salían sin píldora, sin borde y sin fondo: dos links
     azules y un botón gris del navegador adentro de una barra oscura. */
  #mb-content :global(.mb-chip) {
    display: inline-flex; align-items: center;
    font-family: var(--font-ui); font-size: 0.85rem; font-weight: 700;
    line-height: 1; text-decoration: none; white-space: nowrap;
    padding: 10px 18px; border-radius: 999px;
    border: 1px solid rgba(214, 199, 245, 0.34);
    background: rgba(16, 12, 24, 0.58);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
    backdrop-filter: blur(10px) saturate(120%);
    color: rgba(248, 246, 252, 0.92);
    transition: color .2s ease, border-color .2s ease, background .2s ease;
  }
  #mb-content :global(.mb-chip:hover) {
    color: #fff; border-color: rgba(214, 199, 245, 0.6);
    background: rgba(24, 18, 36, 0.72);
  }
  #mb-content :global(.mb-chip--pri) {
    border-color: rgba(79, 199, 158, 0.62);
    background: rgba(10, 46, 36, 0.72); color: #6FE3BC;
  }
  #mb-content :global(.mb-chip--pri:hover) { background: rgba(14, 62, 48, 0.85); color: #8CF0CE; }
  /* "Cerrar sesión" traía un margin-left:auto de tienda.css que lo empujaba
     al extremo; acá ya está dentro del grupo de la derecha. */
  #mb-content .td-logout.mb-chip { margin-left: 0; }

  /* ── El slider del celular ──
     Las cuatro tarjetas dejan la grilla 2x2 y pasan a un riel horizontal con
     snap nativo: cada tarjeta ocupa el 82% del ancho (grande de verdad) y la
     siguiente asoma por la derecha, que es la señal de que se puede deslizar.
     Sin flechas ni librerías: overflow + scroll-snap del navegador. */
  @media (max-width: 767.98px) {
    #mb-content .mb-grid {
      display: flex; gap: 12px;
      overflow-x: auto; scroll-snap-type: x mandatory;
      /* Sangra hasta los bordes de la pantalla para que el asomo se vea. */
      margin-inline: calc(-1 * var(--mb-pad));
      padding: 4px var(--mb-pad) 8px;
      scrollbar-width: none;
    }
    #mb-content .mb-grid::-webkit-scrollbar { display: none; }
    #mb-content .mb-grid > :global(.mb-card) { flex: 0 0 88%; scroll-snap-align: center; }
    /* Los puntitos: tantos como tarjetas, el lleno es la que está clavada.
       Los <i> los escribe el JS: van con :global o el alcance de Astro no
       los toca (la trampa de siempre de esta página). */
    .mb-dots { display: flex; justify-content: center; gap: 7px; margin-top: 14px; }
    .mb-dots :global(i) {
      width: 7px; height: 7px; border-radius: 50%;
      background: rgba(244, 241, 247, .28); transition: background .2s, transform .2s;
    }
    .mb-dots :global(i.act) { background: #4FC79E; transform: scale(1.25); }
  }
  @media (min-width: 768px) { .mb-dots { display: none; } }
  /* tienda.css deja 6px entre la barra de chips y el encabezado, contra los
     30-34px que separan todo lo demás: la volanta quedaba colgada del botón
     "Mi cuenta" como si fuera parte de la barra. En la TV no se nota porque el
     bloque va centrado a lo alto, pero en el celular sí. */
  /* El logo centrado en el ancho con una grilla 1fr/auto/1fr: las dos
     columnas laterales miden lo mismo por definición, así que el centro es
     el centro real de la página, no "lo que sobra" después de los chips. */
  #mb-content .td-head {
    display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center; margin-bottom: var(--mb-v3);
  }
  /* Entre 900 y 1679 el contenido mide 1020px: para que los cuatro chips
     entren en su mitad sin tocar el logo, se achican un punto. */
  @media (min-width: 900px) and (max-width: 1679.98px) {
    #mb-content :global(.mb-chip) { font-size: 12px; padding: 7px 12px; }
  }
  #mb-content .td-head .td-brand { grid-column: 2; }
  #mb-content .mb-acciones { grid-column: 3; justify-self: end; }
  @media (max-width: 899.98px) {
    #mb-content .td-head { display: flex; flex-wrap: wrap; justify-content: center; }
    #mb-content .mb-acciones { margin-left: 0; justify-content: center; }
  }

  /* tienda.css cierra con 140px abajo, reservados para la barra flotante de la
     tienda (.td-bar), que en esta página no existe: en un teléfono son media
     pantalla de nada después del último ítem. El id le gana a .td-content sin
     importar el orden de carga, y /socios/cuenta y /socios/reprocann conservan
     los suyos. */
  #mb-content.td-content { padding-bottom: clamp(28px, 8vw, 56px); }

  /* LA BARRA DE ARRIBA, EN EL CELULAR.
     Los dos accesos largos ("Ver la carta de genéticas" y "Consultar por
     WhatsApp") suman 269px de puro texto: el trío no entra en un renglón
     abajo de 408px de pantalla, hagas lo que hagas con el padding. Así que el
     grupo baja SIEMPRE a su propia fila en vez de pelear por meterse arriba.
     Centrado y no pegado a la izquierda: con flex-start la fila corta dejaba
     161px de sobra a la derecha y el borde se veía dentado.
     Medido: de 4 renglones y 214px de alto en un 320, a 3 renglones y 110. */
  @media (max-width: 560px) {
    #mb-content :global(.mb-chip) { font-size: 12px; padding: 8px 12px; }
    #mb-content .td-head { gap: 12px; }
    .mb-acciones { flex: 1 0 100%; margin-left: 0; justify-content: center; gap: 8px; }
  }

  /* ══ LA PANTALLA DE LA TV ══
     De 1200px para arriba la primera pantalla se compone para mirarse de
     lejos: entra entera sin scroll y la tipografía crece con la ALTURA de la
     pantalla (vh), no con el ancho. Con vw, una TV ancha y baja rompía el
     encuadre; con vh el bloque siempre entra.

     Los selectores van anidados bajo .mb-primera a propósito: las reglas base
     tienen la misma especificidad y el CSS compilado las deja DESPUÉS, así que
     sin anidar ganaban ellas. Un media query no suma especificidad.

     El resto del sitio topea sus clamp cerca de 1360px y no crece más; acá se
     rompe esa regla porque es la única página que se mira a varios metros. */
  @media (min-width: 1200px) {
    /* max-height además de min-height: si la TV tiene barra de navegador o
       otra relación de aspecto, el bloque se comprime en vez de empujar el
       contenido fuera de pantalla. */
    /* Lo que se descuenta es lo que ocupa la barra de chips con su aire: si se
       queda corto, la primera pantalla empieza a scrollear. Estaba clavado en
       76px, que a 1080 daba 5px de margen sobre lo que realmente mide; con un
       clamp en vh acompaña a la escala del resto en pantallas más altas. */
    .mb-primera {
      min-height: calc(100dvh - clamp(76px, 7.5vh, 104px));
      display: flex; flex-direction: column; justify-content: center;
      /* UNA SOLA GRILLA PARA TODA LA PANTALLA. Las cuatro tarjetas marcan las
         cuatro columnas, y el encabezado y el cierre se cuelgan de las MISMAS
         columnas en vez de armar cada uno la suya. Antes el cierre partía la
         pantalla en dos mitades iguales (801px + 54 de calle) y su segunda
         columna arrancaba en 986,9 mientras la tercera tarjeta arrancaba en
         973: 14px de desfasaje, suficiente para que el ojo lea la página
         como dos maquetas distintas apiladas. */
      --mb-gap: clamp(16px, 1.6vw, 26px);
    }
    /* Sin esto, en una pantalla más baja que 1080 (un TV con barra de
       navegador, otra relación de aspecto) el max-height aplastaba los bloques:
       el hero perdía la bajada y el selector se salía por el borde recortado.
       Que la página scrollee un poco es mucho mejor que mostrar algo cortado. */
    .mb-primera > * { flex: none; }

    /* El contenedor de socios está capado en 1020px: en una TV eso dejaba la
       composición usando poco más de la mitad del ancho, con las tarjetas tan
       angostas que el botón partía en dos renglones. */
    /* El contenedor de socios trae 48px arriba y 140px abajo, pensados para
       páginas que scrollean. Acá esos 188px son casi dos tarjetas de alto. */
    #mb-content.td-content {
      --mb-ancho: min(1560px, 94vw);
      max-width: var(--mb-ancho);
      padding-top: clamp(14px, 1.9vh, 26px);
      padding-bottom: clamp(6px, .8vh, 11px);
    }

    /* Acá el bloque va centrado a lo alto, así que el hueco entre la barra y el
       encabezado lo reparte el centrado: alcanza con que escale con la altura,
       no hace falta el aire que necesita el celular. */
    #mb-content .td-head { margin-bottom: clamp(3px, .45vh, 7px); }

    /* El hero se lleva menos aire que en el celular: acá lo que tiene que
       pesar son los precios. Medido a 1080p pasa de 370px a ~250px. */
    /* El padding de arriba le hace lugar a la volanta flotante. */
    .mb-primera .mb-hero { margin-bottom: clamp(10px, 1.5vh, 22px); padding: clamp(20px, 2.3vh, 32px) 0 clamp(6px, .95vh, 13px); }
    .mb-primera .mb-title { font-size: clamp(34px, 5.6vh, 70px); margin-bottom: clamp(6px, .9vh, 13px); }
    .mb-primera .mb-lead { font-size: clamp(12.5px, 1.5vh, 18px); line-height: 1.55; max-width: 74ch; margin-top: 0; color: rgba(244, 241, 247, .84); }
    .mb-primera .mb-eyebrow { font-size: clamp(10px, 1.15vh, 13px); letter-spacing: .2em; margin-bottom: clamp(5px, .8vh, 11px); }

    .mb-primera .mb-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--mb-gap);
      max-width: 100%;
      /* El `margin: 0 auto` de la regla base centra bien en el celular, pero
         acá adentro .mb-primera es un contenedor flex y un margen automático
         en el eje transversal ANULA el estirado: la grilla se encogía a su
         contenido y las tarjetas quedaban en 241px con media pantalla vacía
         al lado. */
      width: 100%;
      margin-inline: 0;
    }

    /* Las reglas de las TARJETAS no van acá: las escribe el JS con lo que viene
       de la base, y Astro le pone su atributo de alcance solo a lo que existe
       al compilar. Están en el <style is:global> de más arriba. */

    /* La razón de todo esto: apilados, estos tres bloques sumaban 1199 px y
       dejaban la página en 2,08 pantallas de TV. En columnas usan el ancho,
       que es justo lo que sobra en 1920. */
    .mb-primera .mb-cierre {
      /* Las MISMAS cuatro columnas que las tarjetas, no dos mitades propias:
         así "Beneficios exclusivos" arranca exactamente donde arranca la
         tercera tarjeta. Cada sección se lleva dos columnas. */
      grid-template-columns: repeat(4, minmax(0, 1fr));
      /* Cuatro renglones compartidos: el encabezado y los tres ítems. Con
         subgrid, cada columna se cuelga de ESTOS renglones en vez de armar los
         suyos, así el ítem 1 de las tres arranca y termina a la misma altura
         aunque uno tenga dos líneas y otro tres. Sin subgrid (navegador viejo)
         degrada a lo de antes: columnas parejas pero renglones sueltos. */
      /* Cuatro renglones fijos, y ahora sí escritos a mano: son el encabezado
         de sección y los TRES que tiene cualquier ítem (ícono, título,
         descripción). Antes este número salía del contenido, porque los ítems
         se apilaban y cada uno era un renglón; ahora van uno al lado del otro y
         lo que depende del contenido son las columnas, que las escribe
         pintarItems sobre cada lista. */
      grid-template-rows: auto repeat(3, auto);
      align-items: start;
      column-gap: var(--mb-gap);
      /* Este row-gap separa el encabezado de sección de su lista (entre ítems
         manda el gap de .mb-items). Va algo MENOR que el hueco entre ítems: el
         h2 tiene que colgar de su lista, no flotar entre dos grupos. El aire
         grande va ARRIBA del h2, en el margin-top de acá abajo: es lo que lo
         despega de las tarjetas. Estaba al revés (22,7 arriba contra 42
         abajo) y el título se leía como pie de las tarjetas. */
      row-gap: clamp(13px, 1.8vh, 26px);
      margin-top: clamp(26px, 3.9vh, 52px);
    }
    /* Dos columnas de tarjeta cada una, sin padding lateral: centrado, el eje
       de cada columna tiene que ser el centro real de sus dos tarjetas. Con un
       padding a la derecha el texto quedaba corrido esos píxeles. */
    .mb-primera .mb-cierre > * { grid-column: span 2; }
    /* Los encabezados de sección nacieron centrados y con ancho máximo para
       cuando cada uno era una sección de página entera. En columna van al ras
       de su texto. */
    .mb-primera .mb-cierre .mb-sec-head {
      max-width: none; margin: 0;
    }
    .mb-primera .mb-cierre .mb-h2 { font-size: clamp(22px, 2.9vh, 38px); }
    @supports (grid-template-rows: subgrid) {
      /* De la primera a la última línea de renglón, sin contar a mano: así el
         span sigue al --mb-filas de arriba solo. */
      .mb-primera .mb-cierre > * {
        display: grid; grid-row: 1 / -1; grid-template-rows: subgrid;
      }
      /* El display de autor le gana al display:none que trae el atributo
         hidden. Sin esto, si falla la carga de textos quedan los dos h2
         sueltos sin lista. */
      .mb-primera .mb-cierre > *[hidden] { display: none; }
      .mb-primera .mb-cierre .mb-items {
        display: grid; grid-row: 2 / -1; grid-template-rows: subgrid;
        /* El row-gap va ACÁ y no se hereda (un subgrid usa su propio gutter
           cuando lo declara). Son los dos huecos de adentro del ítem: entre el
           ícono y el título, y entre el título y su descripción. Chico a
           propósito: las tres cosas son UNA sola unidad y lo que las tiene que
           separar del ítem de al lado es el column-gap, no el aire de arriba.
           El row-gap de .mb-cierre queda gobernando el único renglón que
           .mb-items no cubre: el que separa el encabezado de su lista. */
        row-gap: clamp(2px, .35vh, 5px);
