---
// Membresías de flores, para socios.
//
// No está enlazada en ningún menú y lleva noindex, pero eso NO es lo que la
// protege: la protege la sesión. Sin cookie de socio válida, acá no hay más
// que la pantalla de acceso, porque los precios los sirve
// /api/socios/precios, que exige sesión Y revalida contra el padrón (un socio
// dado de baja deja de verlos al instante, sin esperar a que expire nada).
//
// La lista se carga y se edita desde el panel, en Catálogo → Membresías: los
// números no viven acá.
import Layout from '../../layouts/Layout.astro'
import SociosLogin from '../../components/SociosLogin.astro'
import SociosTos from '../../components/SociosTos.astro'
import '../../styles/global.css'

const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || ''
---

<Layout
  title="Membresías — socios | Flora ONG"
  description="Planes de flores para socios de Flora."
  noindex={true}
>
  <link rel="stylesheet" href="/socios/tienda.css" />
  <main class="td-main">
    <SociosLogin title="Acceso exclusivo para<br /><em class='sl-accent-green'>miembros del club</em>" joinPrompt>
      <Fragment slot="note">Validamos tu identidad en nuestra base de pacientes.<br />No compartimos tus datos.</Fragment>
    </SociosLogin>
    <SociosTos />

    <div id="mb-content" class="td-content" hidden>

      <!-- El video ya no es el fondo del encabezado sino el de la página
           entera: queda fijo detrás de todo y el contenido flota encima. El
           velo es lo que hace que el texto se lea; sin él, sobre hojas en
           movimiento no se lee nada a tres metros. -->
      <div class="mb-fondo" aria-hidden="true">
        <!-- Servido por Pexels: "Cannabis plants swaying in the wind", de
             Nicky Pe (video 12361112). Se enlaza directo, no lo servimos
             nosotros. -->
        <video src="https://videos.pexels.com/video-files/12361112/12361112-hd_1280_720_30fps.mp4"
               poster="https://images.pexels.com/videos/12361112/cannabis-cannabis-cultivation-cannabis-flower-field-12361112.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200"
               muted loop playsinline autoplay preload="none" crossorigin="anonymous"></video>
      </div>

      <div class="td-head">
        <a href="/socios/cuenta/" class="td-back mb-chip">← Mi cuenta</a>
        <div class="td-brand">
          <img class="td-brand-logo" src="/img/flora-logo-white.png" alt="Flora" width="1472" height="298" />
          <span class="td-brand-name"><em>club</em></span>
        </div>
        <div class="mb-acciones">
          <a class="mb-chip mb-chip--pri" id="mb-cta-carta" href="/socios/carta/"></a>
          <a class="mb-chip" id="mb-cta-wa" href="https://wa.me/5492996375723?text=Hola%20Flora%2C%20quiero%20consultar%20por%20mi%20membres%C3%ADa" target="_blank" rel="noopener noreferrer"></a>
          <button id="mb-logout" class="td-logout mb-chip" type="button">Cerrar sesión</button>
        </div>
      </div>

      <!-- LA PRIMERA PANTALLA.
           Esto se muestra en la TV del living, donde nadie scrollea: tiene que
           entrar entero y bastarse solo. De 1200px para arriba se compone en
           una sola pantalla con tipografía de lejos; abajo de eso apila normal
           y el socio lo lee en el celular. Todo lo demás (el ciclo, los
           beneficios, las notas) queda debajo del pliegue a propósito.
           Referencia de la casa: /socios/carta, que ya es la pantalla de la TV. -->
      <div class="mb-primera">

      <!-- Hero con el video del sitio (421 KB) y el mismo velo oscuro que usa
           el resto de floraong.ar. La clase .reveal es el movimiento por
           defecto del sitio: IntersectionObserver, sin GSAP, y ya respeta
           prefers-reduced-motion desde el CSS global. -->
      <!-- Sin selector de forma de pago: la tarjeta ya muestra las dos, el
           contado arriba y el débito abajo como el beneficio que se desbloquea.
           Elegir de antemano era un paso que no decidía nada. -->
      <header class="mb-hero">
        <div class="mb-hero-txt">
          <div class="mb-hero-copy">
            <span class="mb-eyebrow reveal" id="mb-eyebrow"></span>
            <h1 class="mb-title reveal" data-reveal-delay="90" id="mb-title"></h1>
            <p class="mb-lead reveal" data-reveal-delay="180" id="mb-lead"></p>
          </div>
          <!-- El sello legal, al lado del título: es lo primero que tiene que
               quedar claro en un TV que mira gente que todavía no es socia. -->
          <aside class="mb-sello">
            <span class="mb-sello-lb">Ley 27.350 · REPROCANN</span>
            <p class="mb-sello-txt">
              Servicio <strong>exclusivo para personas asociadas</strong> con credencial REPROCANN
              vigente que designe a la <strong>Asociación Civil Cann de Cannabis Medicinal</strong>
              como su cultivadora. Personería jurídica <strong>I.G.J. N.º 1994128</strong>,
              CUIT 30-71827609-4. Lo que recibís <strong>no es una compra</strong>: es la entrega
              de tu propio cultivo, amparado por ese vínculo. Podés dar de baja la suscripción
              cuando quieras, vos mismo, desde Mercado Pago.
            </p>
          </aside>
        </div>
      </header>

      <p id="mb-vacio" class="mb-vacio" hidden>Todavía no hay membresías cargadas.</p>
      <p id="mb-aviso" class="mb-aviso" hidden></p>

      <div id="mb-grid" class="mb-grid"></div>

      <!-- Cierre en tres columnas: por qué conviene, cómo sigue, y la letra
           chica. Apilado ocupaba 1199 px de más y dejaba la página en 2,08
           pantallas de TV; en columnas usa el ancho, que es lo que sobra. -->
      <div class="mb-cierre">

      <!-- El ciclo, con el patrón de pasos numerados de la home (número en
           serif verde sobre línea superior). Cuenta lo que hoy no se explicaba
           en ningún lado: qué pasa después de adherirse. -->
      <section class="mb-ciclo" id="mb-ciclo" hidden aria-label="Cómo funciona el débito">
        <header class="mb-sec-head reveal">
          <span class="mb-eyebrow-v">Una vez adherido</span>
          <h2 class="mb-h2">Se ocupa solo, <em>mes a mes</em></h2>
        </header>
        <ul class="mb-items">
          <li class="mb-item">
            <h3 class="mb-item-t">Te suscribís con Mercado Pago</h3>
            <p class="mb-item-d">Podés elegir pagar con débito, crédito o dinero en cuenta.</p>
          </li>
          <li class="mb-item">
            <h3 class="mb-item-t">Disponibilidad automática</h3>
            <p class="mb-item-d">Tus gramos contratados se habilitan en tu cuenta para que retires cuando quieras.</p>
          </li>
          <li class="mb-item">
            <h3 class="mb-item-t">Lo recibís sin moverte</h3>
            <p class="mb-item-d">Te lo llevamos a tu casa en Neuquén capital, al siguiente día hábil. O lo pasás a buscar por la sede, como prefieras.</p>
          </li>
        </ul>
      </section>

      <section class="mb-beneficios" id="mb-beneficios" hidden>
        <header class="mb-sec-head reveal">
          <span class="mb-eyebrow-v">Por qué conviene</span>
          <h2 class="mb-h2">Lo que ganás <em>con el débito</em></h2>
        </header>
        <!-- Acá va el POR QUÉ, no el cómo: el cómo lo cuenta el ciclo de al lado.
             Antes esto convivía con una tira de tres frases arriba de las
             tarjetas que decía lo mismo con otras palabras, y con un cuarto
             paso del ciclo sobre los gramos que se acumulan: los tres decían
             una parte y ninguno pesaba. Quedó uno solo, en frases cortas,
             porque en la TV esto se lee a varios metros. -->
        <ul class="mb-items">
          <li class="mb-item">
            <b class="mb-item-t">20% menos, por 3 meses</b>
            <span class="mb-item-d">Ese precio queda fijo aunque suba la lista.</span>
          </li>
          <li class="mb-item">
            <b class="mb-item-t">Envío sin cargo</b>
            <span class="mb-item-d">A tu domicilio en Neuquén capital, al siguiente día hábil.</span>
          </li>
          <li class="mb-item">
            <b class="mb-item-t">No perdés lo que no retirás</b>
            <span class="mb-item-d">Si un mes no podés pasar, se te acumula.</span>
          </li>
        </ul>
      </section>


      </div><!-- /mb-cierre -->

      </div><!-- /mb-primera -->
    </div>
  </main>
</Layout>

<script src="https://accounts.google.com/gsi/client" async defer is:inline></script>

<script define:vars={{ googleClientId }}>
  const pesos = (n) => '$' + Number(n).toLocaleString('es-AR')
  const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c])

  let ETIQUETAS = { uno: '', dos: '' }
  let ACTUAL = { tier: null, debitoActivo: false, puede: false, motivo: null }
  let PLANES = []
  // El contado arranca seleccionado: es el precio de referencia. El descuento
  // no es "otro precio", es lo que se desbloquea al suscribirse al débito.

  function tarjeta(p) {
    const esMia = ACTUAL.tier && p.item === ACTUAL.tier
    // Un frasco por cada 10 g. Es lo que hace que la diferencia entre planes
    // se vea de lejos sin tener que leer el número.
    const FRASCO = '<svg class="mb-frasco" viewBox="0 0 14 20" aria-hidden="true"><rect x="4.4" y="1" width="5.2" height="2.6" rx=".8"/><path d="M3.4 3.6h7.2a2 2 0 0 1 2 2v11.4a2 2 0 0 1-2 2H3.4a2 2 0 0 1-2-2V5.6a2 2 0 0 1 2-2Z"/></svg>'
    const frascos = p.gramos
      ? `<p class="mb-frascos" aria-hidden="true">${FRASCO.repeat(Math.max(1, Math.min(6, Math.round(p.gramos / 10))))}</p>`
      : ''
    const detalle = p.gramos ? `${frascos}<p class="mb-card-det">${p.gramos} gramos por mes</p>` : ''
    const ofreceDebito = !!(p.debito && p.linkDebito)
    const puedeBoton = ofreceDebito && !ACTUAL.debitoActivo && ACTUAL.puede
    const btn = puedeBoton
      ? `<button type="button" class="mb-adherir" data-tier="${esc(p.item)}"><span>Suscribir con</span><img class="mb-adherir-mp" src="/img/mp-logo-full.png" alt="Mercado Pago" width="284" height="74" /></button>`
      : ''

    // El precio de referencia arriba, y el débito abajo como el beneficio que
    // se desbloquea, con su propio bloque. Antes había un selector que cambiaba
    // entre dos vistas; mostrar las dos juntas es lo que hace visible el salto.
    const gancho = ofreceDebito
      ? `<div class="mb-gancho">
          <span class="mb-gancho-lb">Con débito automático</span>
          <b class="mb-gancho-precio">${pesos(p.debito)}</b>
          ${p.contado ? `<span class="mb-gancho-ahorro">ahorrás ${pesos(p.contado - p.debito)} por mes</span>` : ''}
          <span class="mb-gancho-envio">+ envío sin cargo</span>
          ${btn}
        </div>`
      : ''
    return `<article class="mb-card${esMia ? ' mb-card--mia' : ''}">
      <span class="mb-mia"${esMia ? '' : ' aria-hidden="true"'}>${esMia ? 'Tu membresía' : ''}</span>
      <h3 class="mb-card-nom">${esc(p.item)}</h3>
      ${detalle}
      <p class="mb-card-precio">${pesos(p.contado)}<span>${esc(ETIQUETAS.uno) || 'Contado o transferencia'}</span></p>
      <p class="mb-card-retiro">Lo retirás en la sede</p>
      ${gancho}
    </article>`
  }

  function pintarPlanes() {
    document.getElementById('mb-grid').innerHTML = PLANES.map(tarjeta).join('')
    document.getElementById('mb-vacio').hidden = PLANES.length > 0
    // Los beneficios solo tienen sentido para quien todavía puede adherirse.
    const oculto = ACTUAL.debitoActivo || !ACTUAL.puede
    const ben = document.getElementById('mb-beneficios')
    if (ben) ben.hidden = oculto
    // El ciclo se muestra igual a quien ya está adherido: le explica cómo
    // funciona lo que ya tiene andando.
    const cic = document.getElementById('mb-ciclo')
    if (cic) cic.hidden = !ACTUAL.puede && !ACTUAL.debitoActivo
  }

  function pintar(d) {
    const tx = d.textos || {}
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val || '' }
    set('mb-eyebrow', tx.eyebrow)
    const tit = document.getElementById('mb-title')
    tit.textContent = tx.titulo || ''
    if (tx.tituloEm) {
      const em = document.createElement('em')
      em.textContent = ' ' + tx.tituloEm
      tit.appendChild(em)
    }
    set('mb-lead', tx.lead)

    ETIQUETAS = { uno: tx.etiquetaPrecio || '', dos: tx.etiquetaPrecio2 || '' }
    ACTUAL = d.actual || { tier: null, debitoActivo: false }

    PLANES = Array.isArray(d.planes) ? d.planes : []
    pintarPlanes()

    // Quien no puede adherirse ve POR QUÉ y adónde ir. Un botón que
    // simplemente no está deja a la persona sin saber qué le falta.
    const av = document.getElementById('mb-aviso')
    if (ACTUAL.debitoActivo) {
      av.innerHTML = 'Ya tenés el débito automático activo. Para cambiar de membresía, escribinos.'
      av.hidden = false
    } else if (!ACTUAL.puede) {
      const wa = 'https://wa.me/5492996375723?text=' + encodeURIComponent('Hola Flora, quiero adherirme al débito automático')
      av.innerHTML = `<b>Para adherirte al débito automático, tu REPROCANN tiene que estar presentado.</b><br />`
        + esc(ACTUAL.motivo || '')
        + ` <a href="/socios/reprocann/">Ver mi trámite</a> · <a href="${wa}" target="_blank" rel="noopener">Escribinos</a>`
      av.hidden = false
    } else { av.hidden = true }

    // La columna de letra chica se sacó de la página: lo legal vive ahora en
    // el sello del encabezado. Los textos siguen guardados en el backoffice
    // por si se quiere volver a mostrar.
    set('mb-cta-carta', tx.ctaCarta)
    set('mb-cta-wa', tx.ctaWhatsapp)
  }

  // Un click: se registra la adhesión y se abre el checkout de Mercado Pago.
  async function adherir(btn) {
    const tier = btn.dataset.tier
    btn.disabled = true
    const original = btn.textContent
    btn.textContent = 'Abriendo…'
    try {
      const r = await fetch('/api/socios/adherir', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tier }),
      })
      const d = await r.json().catch(() => ({}))
      if (r.ok && d.ok && d.link) { location.href = d.link; return }
      const av = document.getElementById('mb-aviso')
      av.textContent = d.error || 'No se pudo abrir la adhesión. Escribinos y lo resolvemos.'
      av.hidden = false
    } catch {
      const av = document.getElementById('mb-aviso')
      av.textContent = 'No se pudo conectar. Probá de nuevo.'
      av.hidden = false
    }
    btn.disabled = false
    btn.textContent = original
  }

  document.addEventListener('click', (e) => {
    const b = e.target.closest('.mb-adherir')
    if (b) { adherir(b); return }
  })

  async function cargar() {
    // Sin sesión válida no se pinta nada: queda la pantalla de acceso.
    const yoRes = await fetch('/api/socios/yo', { credentials: 'include' })
    if (!yoRes.ok) return false

    // Una sola llamada trae todo: los textos (editables en el panel), los
    // planes de la lista de precios vigente y en qué situación está el socio.
    const res = await fetch('/api/socios/membresias', { credentials: 'include' })
    const d = res.ok ? await res.json().catch(() => null) : null
    if (d?.ok) pintar(d)

    document.getElementById('socios-login').hidden = true
    document.getElementById('mb-content').hidden = false
    return true
  }

  // Mismo flujo de acceso que /socios/cuenta: Google, aceptación de términos
  // y el mensaje de "todavía no estás en el padrón" con el formulario a mano.
  async function submitLogin(credential, tosAccept) {
    try {
      const res = await fetch('/api/socios/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ credential, tosAccept: !!tosAccept }),
      })
      const data = await res.json()
      if (res.ok && data.ok) {
        window.hideSociosTos()
        await cargar()
        return
      }
      if (data.needsTos) {
        window.showSociosTos({ mode: 'accept', onAccept: () => submitLogin(credential, true) })
        return
      }
      const msg = document.getElementById('socios-login-msg')
      if (res.status === 403) {
        const wa = 'https://wa.me/5492996375723?text=' + encodeURIComponent('Hola Flora, quiero conocer el club 🌿')
        msg.innerHTML = `Todavía no estás en el padrón del club. <button type="button" class="sl-msg-cta" data-intent="acceso">Pedí tu acceso acá</button> y te contactamos, o escribinos por <a href="${wa}" target="_blank" rel="noopener">WhatsApp</a>.`
      } else {
        msg.textContent = data.error || 'No se pudo verificar tu cuenta.'
      }
      msg.hidden = false
    } catch {
      const msg = document.getElementById('socios-login-msg')
      msg.textContent = 'Error de red al verificar con Google.'
      msg.hidden = false
    }
  }

  window.handleGoogleCredential = (response) => submitLogin(response.credential, false)

  document.getElementById('mb-logout').addEventListener('click', async () => {
    await fetch('/api/socios/logout', { method: 'POST', credentials: 'include' })
    location.href = '/'
  })

  if (googleClientId) {
    window.onload = () => {
      google.accounts.id.initialize({ client_id: googleClientId, callback: window.handleGoogleCredential })
      google.accounts.id.renderButton(document.getElementById('g_id_button'), {
        width: 320, theme: 'filled_black', size: 'large', text: 'signin_with',
      })
    }
  }

  cargar()
</script>

<style is:global>
  html, body { background-color: #130d1c; }

  /* Estas piezas las escribe el JS con el contenido que viene del panel, así
     que NO pueden ir en el bloque scoped: Astro le pone su atributo de alcance
     solo a lo que existe al compilar, y el HTML inyectado se quedaba sin
     estilo. */
  /* Sobre el video una tarjeta al 4% de blanco es literalmente transparente y
     el precio se pierde entre las hojas. Va oscura y sólida: el video se ve
     alrededor, no atrás del número. */
  .mb-card {
    background: rgba(14, 9, 21, 0.86);
    border: 1px solid rgba(183, 157, 230, 0.22);
    border-radius: 18px; padding: 22px 20px; text-align: center;
  }
  .mb-card-nom {
    font-family: var(--font-ui); font-size: 13px; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase;
    color: rgba(244, 241, 247, 0.9); margin: 0 0 6px;
  }
  .mb-card-det {
    font-family: var(--font-ui); font-size: 13.5px;
    color: rgba(244, 241, 247, 0.55); margin: 0 0 14px;
  }
  .mb-card-precio {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(26px, 4vw, 32px);
    color: #4FC79E; margin: 0; line-height: 1.1;
    /* Newsreader trae eje óptico: a tamaño grande afina los remates sola. */
    font-optical-sizing: auto;
  }
  .mb-card-precio span {
    display: block; font-family: var(--font-ui); font-size: 12px;
    color: rgba(244, 241, 247, 0.45); margin-top: 4px;
  }
  .mb-card-alt {
    margin: 12px 0 0; padding-top: 10px;
    border-top: 1px solid rgba(183, 157, 230, 0.16);
  }
  .mb-card-alt b {
    display: block; font-family: var(--font-display); font-weight: 400;
    font-size: 20px; color: rgba(244, 241, 247, 0.9); line-height: 1.15;
  }
  .mb-card-alt span {
    display: block; font-family: var(--font-ui); font-size: 11.5px;
    color: rgba(244, 241, 247, 0.45); margin-top: 3px;
  }
  .mb-card--mia { border-color: rgba(60, 180, 146, .55); background: rgba(14, 30, 26, .8); }
  /* El chip se renderiza SIEMPRE, vacío cuando no corresponde: así reserva el
     mismo alto en las cuatro tarjetas y no desalinea la marcada. */
  .mb-mia {
    display: inline-block; font-family: var(--font-ui); font-size: 10px; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase; color: #4FC79E;
    background: rgba(60, 180, 146, .14); border-radius: 999px;
    /* line-height fijo para que el chip vacío mida exactamente lo mismo que el
       que tiene texto: sin esto las tarjetas quedaban 8px desalineadas. */
    padding: 4px 10px; margin-bottom: 10px; line-height: 13px; min-width: 1px;
  }
  /* Un inline-block VACÍO no genera caja de línea, así que medía 8px contra
     los 21px del que tiene texto. El espacio de ancho cero le da esa caja
     sin verse. */
  .mb-mia:empty { background: none; }
  .mb-mia:empty::before { content: "\200b"; }
  /* El logo oficial de Mercado Pago está dibujado para fondo claro: sobre el
     celeste de marca no se lee. Por eso el botón va blanco, que además es
     como se ven los botones oficiales de "pagar con". */
  .mb-adherir {
    display: flex; align-items: center; justify-content: center; gap: 7px;
    width: 100%; margin-top: 14px;
    font: inherit; font-family: var(--font-ui); font-size: 13px; font-weight: 700;
    color: #1c1626; background: #fff; border: 0; border-radius: 999px;
    padding: 10px 14px; cursor: pointer;
  }
  /* En la tarjeta angosta del celular, "Suscribir con" partía en dos renglones
     y el botón crecía al doble de alto. */
  .mb-adherir span { white-space: nowrap; }
  .mb-adherir-mp { height: 15px; width: auto; display: block; flex: none; }
  .mb-adherir:hover { filter: brightness(.94); }
  .mb-adherir:disabled { opacity: .6; cursor: default; }
  /* El bloque que desbloquea el descuento. Va con el celeste de Mercado Pago
     para que se lea como "esto es lo que pasa si te suscribís", separado del
     precio de referencia de arriba. */
  .mb-gancho {
    margin: 16px -4px 0; padding: 13px 12px 14px;
    background: rgba(0, 158, 227, .09);
    border: 1px solid rgba(0, 158, 227, .28);
    border-radius: 14px;
  }
  .mb-gancho-lb {
    display: block; font-family: var(--font-ui); font-size: 10.5px; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: #4cb8e8; margin-bottom: 4px;
  }
  .mb-gancho-precio {
    display: block; font-family: var(--font-display); font-weight: 600;
    font-size: 24px; color: #f4f1f7; line-height: 1.1;
  }
  .mb-gancho-ahorro {
    display: block; font-family: var(--font-ui); font-size: 12px;
    color: rgba(244, 241, 247, .55); margin-top: 3px;
