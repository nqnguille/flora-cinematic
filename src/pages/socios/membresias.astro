    .mb-fondo video { display: none; }
    .mb-fondo { background: #130d1c url('https://images.pexels.com/videos/12361112/cannabis-cannabis-cultivation-cannabis-flower-field-12361112.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200') center / cover; }
  }

  .mb-hero { margin: 0 0 34px; }
