         subgrid, cada columna se cuelga de ESTOS renglones en vez de armar los
         suyos, así el ítem 1 de las tres arranca y termina a la misma altura
         aunque uno tenga dos líneas y otro tres. Sin subgrid (navegador viejo)
         degrada a lo de antes: columnas parejas pero renglones sueltos. */
      grid-template-rows: auto repeat(3, auto);
      align-items: start;
      gap: clamp(26px, 2.8vw, 54px);
      margin-top: clamp(14px, 2.1vh, 30px);
      padding-top: 0;
      text-align: left;
    }
    /* Los encabezados de sección nacieron centrados y con ancho máximo para
       cuando cada uno era una sección de página entera. En columna van al ras
       de su texto. */
    .mb-primera .mb-cierre .mb-sec-head {
      max-width: none; margin: 0 0 clamp(6px, 1vh, 12px); text-align: left;
    }
    .mb-primera .mb-cierre .mb-eyebrow-v { font-size: clamp(10px, 1.2vh, 13px); margin-bottom: clamp(3px, .5vh, 7px); }
    .mb-primera .mb-cierre .mb-h2 { font-size: clamp(17px, 2.1vh, 26px); }
    @supports (grid-template-rows: subgrid) {
      .mb-primera .mb-cierre > * {
        display: grid; grid-row: span 4; grid-template-rows: subgrid;
      }
      .mb-primera .mb-cierre .mb-items {
        display: grid; grid-row: span 3; grid-template-rows: subgrid;
        /* SIN row-gap propio: un subgrid hereda el del padre, y ponerlo en 0
           dejaba los ítems literalmente pegados. El aire entre renglones lo
