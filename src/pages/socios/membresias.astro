      grid-template-rows: auto repeat(3, auto);
      align-items: start;
      gap: clamp(26px, 2.8vw, 54px);
      margin-top: clamp(6px, .8vh, 12px);
      padding-top: clamp(6px, .8vh, 12px);
      border-top: 1px solid rgba(183, 157, 230, .16);
