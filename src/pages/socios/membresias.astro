  /* El velo es lo que hace legible todo lo demás. Sobre hojas en movimiento,
     sin esto no se lee un precio a tres metros. Dos capas: un oscurecido
     parejo y un degradado que carga más abajo, donde va el texto chico. */
  .mb-fondo::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(to bottom, rgba(19, 13, 28, .38) 0%, rgba(19, 13, 28, .6) 48%, rgba(19, 13, 28, .82) 100%),
      rgba(19, 13, 28, .12);
